@using GSBC.ImpactKids.Shared.Contracts.Entities.Features.Scripture.Memorisation
@using GSBC.ImpactKids.Shared.Contracts.Services.Features.Scheduling.School
@using GSBC.ImpactKids.Shared.Contracts.Services.Features.Scripture.Memorisation
@inherits EventListeningComponent
@page "/Term/{Id:guid?}"

@inject ISchoolTermsService      SchoolTermsService
@inject IDollarStoreEntryService DollarStoreEntryService
@inject IMemoryVerseListsService MemoryVerseListsService
@inject NavigationManager        Navigation

@if (_term != null)
{
    <PageTitle>@_term.Name</PageTitle>

    <MudPaper Elevation="6" Class="mt-4">
        <EntityHeader Name="@_term.Name"
                      OnUpdate="UpdateSchoolTerm"
                      OnDelete="DeleteSchoolTerm"/>
        <MudGrid Spacing="6" Justify="Justify.Center" Class="pt-3 pb-6 px-3">
            <MudItem xs="12" md="4">
                <MudPaper Elevation="6">
                    <ServicesList SchoolTerm="_term"/>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudPaper Elevation="6">
                    <MudList T="string">
                        <MudListItem>
                            <MudButton FullWidth
                                       OnClick="@(_ => CreateMemoryVerseList())"
                                       StartIcon="@Icons.Material.Filled.PostAdd">
                                Create Memory Verse List
                            </MudButton>
                        </MudListItem>
                        @if (_lists != null)
                        {
                            if (_lists.Count != 0)
                            {
                                <MudDivider/>
                            }

                            foreach (MemoryVerseList list in _lists)
                            {
                                <div>
                                    <MudListItem
                                        Href="@($"/MemoryVerseList/{list.Id}")"
                                        Text="@(list.Name)"/>
                                </div>
                            }
                        }
                    </MudList>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudPaper Elevation="6">
                    <MudList T="string">
                        <MudListItem>
                            <MudButton FullWidth
                                       OnClick="@(_ => CreateDollarStoreEntry())"
                                       StartIcon="@Icons.Material.Filled.AddBusiness">
                                Create Dollar Store Entry
                            </MudButton>
                        </MudListItem>
                        @if (_dollarStoreEntries != null)
                        {
                            if (_dollarStoreEntries.Count != 0)
                            {
                                <MudDivider/>
                            }

                            foreach (DollarStoreEntry entry in _dollarStoreEntries)
                            {
                                <div>
                                    <MudListItem
                                        Href="@($"/Service?Id={entry.ServiceId}")">
                                        <MudText Inline>
                                            @(entry.ServiceId)
                                        </MudText>
                                        @if (entry.DollarDoosMade != null)
                                        {
                                            <MudChip T="int" Class="mb-2" Icon="@Icons.Material.Filled.AttachMoney">
                                                @entry.DollarDoosMade
                                            </MudChip>
                                        }
                                    </MudListItem>
                                </div>
                            }
                        }
                    </MudList>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudPaper>
}