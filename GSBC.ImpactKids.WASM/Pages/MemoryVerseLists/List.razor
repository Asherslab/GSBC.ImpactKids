@inherits EventListeningComponent
@page "/MemoryVerseList/{Id:guid}"

@using GSBC.ImpactKids.Shared.Contracts.Entities.MemoryVerses
@inject IMemoryVerseListsService MemoryVerseListsService
@inject IMemoryVersesService     MemoryVersesService
@inject NavigationManager        Navigation

@if (_list != null)
{
    <PageTitle>@_list.Name</PageTitle>

    <MudPaper Elevation="6" Class="mt-4">
        <EntityHeader Name="@_list.Name"
                      OnUpdate="@UpdateList"
                      OnDelete="@DeleteList"/>
        <MudButton FullWidth
                   Class="py-5"
                   OnClick="@CreateMemoryVerse"
                   StartIcon="@Icons.Material.Filled.PostAdd">
            Add Memory Verse
        </MudButton>
        <MudGrid Spacing="6" Justify="Justify.Center" Class="pt-3 pb-6 px-3">
            @foreach (MemoryVerse verse in _memoryVerses)
            {
                <MudItem xs="12" md="3">
                    <MudCard Elevation="6">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">@verse.ReferenceName</MudText>
                            </CardHeaderContent>
                            <CardHeaderActions>
                                <MudIconButton OnClick="@(_ => DeleteMemoryVerse(verse))"
                                               Icon="@Icons.Material.Filled.Delete"/>
                                <MudIconButton OnClick="@(_ => UpdateMemoryVerse(verse))"
                                               Icon="@Icons.Material.Filled.Edit"/>
                            </CardHeaderActions>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudText Typo="Typo.body1">@verse.Verse</MudText>
                        </MudCardContent>
                    </MudCard>

                </MudItem>
            }
        </MudGrid>
    </MudPaper>
}