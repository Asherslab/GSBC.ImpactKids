@inherits EntityUtilityComponent
@page "/Analytics/{DashboardLabel}"
@attribute [Authorize]
@inject IRefreshableStore<MetabaseEmbed> MetabaseEmbedsStore
@inject IMetabaseService                 MetabaseService

<PageTitle>@(DashboardLabel ?? "Kids Dashboard")</PageTitle>

<MudStack Row Class="mt-4 align-center justify-space-between">
    <MudText Typo="Typo.h6">@(DashboardLabel ?? "Kids Dashboard")</MudText>
    <MudIconButton
        Icon="@Icons.Material.Filled.Refresh"
        Color="Color.Primary"
        Disabled="@(_refreshing || _embed == null)"
        OnClick="@RefreshClicked"
        aria-label="Refresh"/>
</MudStack>

@if (_error != null)
{
    <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert>
}

<MudPaper Elevation="6" Class="mt-4 relative" Style="height: 90vh">
    <MudOverlay Visible="@(_token == null && _error == null)" DarkBackground Absolute>
        <MudProgressCircular Indeterminate/>
    </MudOverlay>
    @if (_token != null)
    {
        <iframe
            @key="_iframeKey"
            src="@_reportUrl"
            width="100%"
            height="100%"
            allowtransparency>
        </iframe>
    }
</MudPaper>
