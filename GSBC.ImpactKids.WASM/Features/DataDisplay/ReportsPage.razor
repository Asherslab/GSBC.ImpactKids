@using GSBC.ImpactKids.Shared.Contracts.Messages.Requests.Elvanto
@using GSBC.ImpactKids.Shared.Contracts.Services.Features.Elvanto
@inject IElvantoService ElvantoService
@page "/Reports/{ReportLabel}"
@attribute [Authorize]

@if (_label != null)
{
    <PageTitle>@_label</PageTitle>
}
else
{
    <PageTitle>Elvanto Report</PageTitle>
}


<MudPaper Elevation="6" Class="mt-4" Style="height: 90vh">
    @if (_reportUrl != null)
    {
        <iframe
            @key="_iframeKey"
            src="@_reportUrl"
            width="100%"
            height="100%"
            allowtransparency>
        </iframe>
    }
</MudPaper>

@code {

    [Parameter]
    public required string ReportLabel { get; set; }

    private Guid    _iframeKey = Guid.NewGuid();
    private string? _label;
    private string? _reportUrl;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        _iframeKey = Guid.NewGuid();
        StateHasChanged();
        ElvantoReportResponse? resp = await ElvantoService.GetElvantoReport(ReportLabel);

        if (resp == null)
            return;

        _label = resp.Label;
        _reportUrl = $"https://ministry.baptist.com.au/report/?id={resp.Id}&authkey={resp.AuthKey}";
        StateHasChanged();
    }

}