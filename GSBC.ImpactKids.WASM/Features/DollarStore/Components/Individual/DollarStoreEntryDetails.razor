@inherits DetailsComponent<DollarStoreEntry, CreateDollarStoreEntryRequest, UpdateDollarStoreEntryRequest>

<MudPaper Elevation="0" Class="d-flex flex-column flex-grow-1">
    <MudOverlay Visible="@(Entity.IsLoading)"
                DarkBackground="true"
                Absolute="true">
        <MudProgressCircular Indeterminate/>
    </MudOverlay>
    @if (Entity.HasError)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">
            @(Entity.Error ?? "An Unexpected error occured")
        </MudAlert>
    }
    <MudNumericFieldCreateorUpdate
        @bind-Create="@CreateRequest.DollarDoosMade"
        Read="@UpdateRequest.DollarDoosMade.Value"
        @bind-Update="@UpdateRequest.DollarDoosMade.Value"
        State="State"

        Class="mb-4"
        Label="Dollary Doos Made"
        Variant="Variant.Filled"
        Immediate/>
    <MudTextFieldCreateOrUpdate
        @bind-Create="@CreateRequest.Notes"
        Read="@UpdateRequest.Notes.Value"
        @bind-Update="@UpdateRequest.Notes.Value"
        State="State"

        Lines="5"
        Class="mb-4"
        Label="Notes"
        Variant="Variant.Filled"
        Immediate/>
</MudPaper>