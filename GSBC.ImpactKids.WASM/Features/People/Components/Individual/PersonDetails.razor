@inject IPersonService                 PersonService
@inject ISnackbar                      Snackbar
@inject IRefreshableStore<Person>      PeopleStore
@inject IRefreshableStore<SchoolGrade> SchoolGradesStore

<MudPaper Elevation="0" Class="d-flex flex-column flex-grow-1">
    @_person.IsLoading
    <MudOverlay Visible="@(_person.IsLoading)"
                DarkBackground="true"
                Absolute="true">
        <MudProgressCircular Indeterminate/>
    </MudOverlay>
    @if (_person.HasError)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">
            @(_person.Error ?? "An Unexpected error occured")
        </MudAlert>
    }
    <MudPaper Elevation="0" Class="d-flex flex-row flex-grow-1 mb-4">
        <MudTextFieldCreateOrUpdate
            @bind-Create="@_createRequest.FirstName"
            Read="@_updateRequest.FirstName.Value"
            @bind-Update="@_updateRequest.FirstName.Value"
            State="State"

            Class="mr-4"
            Label="First Name"
            Variant="Variant.Filled"
            Immediate/>
        <MudTextFieldCreateOrUpdate
            @bind-Create="@_createRequest.LastName"
            Read="@_updateRequest.LastName.Value"
            @bind-Update="@_updateRequest.LastName.Value"
            State="State"

            Label="Last Name"
            Variant="Variant.Filled"
            Immediate/>
    </MudPaper>

    <div class="relative mb-4">
        <MudOverlay Visible="@(SchoolGradesStore.GetState().Entities.IsLoading)"
                    DarkBackground
                    Absolute>
            <MudProgressCircular Indeterminate/>
        </MudOverlay>
        <MudSelectCreateOrUpdate
            @bind-Create="@_createRequest.SchoolGradeId"
            Read="@_updateRequest.SchoolGradeId.Value"
            @bind-Update="@_updateRequest.SchoolGradeId.Value"
            State="State"

            Label="School Grade"
            Variant="Variant.Filled"

            Clearable>
            @if (SchoolGradesStore.GetState().Entities.HasData)
            {
                @foreach (SchoolGrade schoolGrade in SchoolGradesStore.GetState().Entities.Data!)
                {
                    <MudSelectItem T="Guid?"
                                   Value="@schoolGrade.Id">
                        @(schoolGrade.Label)
                    </MudSelectItem>
                }
            }
        </MudSelectCreateOrUpdate>
    </div>

    <MudSelectCreateOrUpdate
        @bind-Create="@_createRequest.MediaConsent"
        Read="@_updateRequest.MediaConsent.Value"
        @bind-Update="@_updateRequest.MediaConsent.Value"
        State="State"

        Class="mb-4"
        Label="Media Consent"
        Variant="Variant.Filled"

        Clearable>
        @foreach (MediaConsent consent in Enum.GetValues<MediaConsent>())
        {
            <MudSelectItem Value="consent">@consent.ToDisplay()</MudSelectItem>
        }
    </MudSelectCreateOrUpdate>

    <MudDatePickerCreateOrUpdate
        @bind-Create="@_createRequest.LocalDateOfBirth"
        Read="@_updateRequest.LocalDateOfBirth.Value"
        @bind-Update="@_updateRequest.LocalDateOfBirth.Value"
        State="State"

        Class="mb-4"
        Label="Date of Birth"
        Variant="Variant.Filled"

        Editable/>

    <MudDatePickerCreateOrUpdate
        @bind-Create="@_createRequest.LocalFirstTime"
        Read="@_updateRequest.LocalFirstTime.Value"
        @bind-Update="@_updateRequest.LocalFirstTime.Value"
        State="State"

        Label="First Time at Impact Kids"
        HelperText="01/01/2025 is used to signify that the first time was before our systems were in place to track it"
        Variant="Variant.Filled"

        Editable/>
</MudPaper>