@inherits DetailsComponent<Person, CreatePersonRequest, UpdatePersonRequest>

<MudPaper Elevation="0" Class="d-flex flex-column flex-grow-1">
    <MudOverlay Visible="@(Entity.IsLoading)"
                DarkBackground="true"
                Absolute="true">
        <MudProgressCircular Indeterminate/>
    </MudOverlay>
    @if (Entity.HasError)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">
            @(Entity.Error ?? "An Unexpected error occured")
        </MudAlert>
    }
    @* The face, above the name fields. With no photo this is the same coloured initial the person
       cards already show, so the card reads as it did before photos existed. *@
    <MudPaper Elevation="0" Class="d-flex flex-column align-center mb-4">
        <PersonAvatar Person="@Entity.Data" Color="@AvatarColor" Size="Size.Large"/>
        @* Set by anyone who notices an out-of-date face; the Photos tool clears it by taking a new
           one. Hidden while creating, because a person who does not exist yet cannot have a stale
           photo. *@
        @* Not in BasicView: that is the reduced card the sign-in "Confirm" step shows, where this is
           clutter on a screen a leader is trying to get past. The avatar stays there - a face helps
           confirm the right child - but the flag belongs on the full person page. *@
        @if (!BasicView && State != ModificationState.Creating)
        {
            <MudCheckBoxCreateOrUpdate
                Read="@UpdateRequest.PhotoNeedsUpdate.Value"
                @bind-Update="@UpdateRequest.PhotoNeedsUpdate.Value"
                State="State"

                Label="Needs a new photo"/>
        }
        @* The second way in, for the child who is not standing in front of a leader at sign-in: the
           Photos tool only lists people signed in tonight, so before this the face could not be set
           or corrected from the person's own page at all.

           Reading only, and not while editing. The upload writes immediately through its own
           endpoint - it is not part of UpdateRequest and no Save button applies to it - and the
           update event it raises is exactly what DetailsComponent watches to cancel an in-progress
           edit with "Somebody has made modifications". Offering it mid-edit would mean a leader
           taking a photo and losing the name they were half way through typing. *@
        @if (!BasicView && State == ModificationState.Reading && Entity.Data != null)
        {
            <MudButton Variant="Variant.Text"
                       Color="MudBlazor.Color.Primary"
                       StartIcon="@Icons.Material.Filled.PhotoCamera"
                       Class="mt-2"
                       OnClick="@OpenCapture">
                @(Entity.Data.PhotoVersion == null ? "Add photo" : "Change photo")
            </MudButton>
        }
    </MudPaper>

    <MudPaper Elevation="0" Class="d-flex flex-row flex-grow-1 mb-4">
        <MudTextFieldCreateOrUpdate
            @bind-Create="@CreateRequest.FirstName"
            Read="@UpdateRequest.FirstName.Value"
            @bind-Update="@UpdateRequest.FirstName.Value"
            State="State"

            Class="mr-4"
            Label="First Name"
            Variant="Variant.Filled"
            Immediate/>
        <MudTextFieldCreateOrUpdate
            @bind-Create="@CreateRequest.LastName"
            Read="@UpdateRequest.LastName.Value"
            @bind-Update="@UpdateRequest.LastName.Value"
            State="State"

            Label="Last Name"
            Variant="Variant.Filled"
            Immediate/>
    </MudPaper>


    <MudDatePickerCreateOrUpdate
        @bind-Create="@CreateRequest.LocalDateOfBirth"
        Read="@UpdateRequest.LocalDateOfBirth.Value"
        @bind-Update="@UpdateRequest.LocalDateOfBirth.Value"
        State="State"

        Class="mb-4"
        Label="Date of Birth"
        Variant="Variant.Filled"

        DateFormat="dd/MM/yyyy"
        Editable/>

    @if (Age() != null)
    {
        <MudText Typo="Typo.caption"
                 Class="mt-n3 mb-4 ml-3"
                 Color="@(AgeWarning() == null ? Color.Default : Color.Warning)">
            Currently @Age() years old
        </MudText>
    }

    @if (!BasicView)
    {
        <MudPaper Elevation="0" Class="d-flex flex-row flex-grow-1 mb-4">
            <div class="relative mr-4" style="width: 100%">
                <MudOverlay Visible="@(_families.IsLoading)"
                            DarkBackground
                            Absolute>
                    <MudProgressCircular Indeterminate/>
                </MudOverlay>
                <MudSelectCreateOrUpdate
                    @bind-Create="@CreateRequest.FamilyId"
                    Read="@UpdateRequest.FamilyId.Value"
                    @bind-Update="@UpdateRequest.FamilyId.Value"
                    State="State"

                    Label="Family"
                    Variant="Variant.Filled"

                    Clearable>
                    @* "No family" is a real choice now, and it needs a real item: the select renders
                       whatever it is bound to, so without one a person with no household showed the
                       raw "00000000-0000-0000-0000-000000000000" in the field. *@
                    <MudSelectItem T="Guid?" Value="@Guid.Empty">No family</MudSelectItem>
                    @if (_families.HasData)
                    {
                        foreach (FamilyDefinition family in _families.Data!)
                        {
                            <MudSelectItem T="Guid?" Value="family.Id">
                                @family.FamilyName (@family.FamilyCount)
                            </MudSelectItem>
                        }
                    }
                </MudSelectCreateOrUpdate>
            </div>
            <MudCheckBoxCreateOrUpdate
                @bind-Create="@CreateRequest.FamilyGuardian"
                Read="@UpdateRequest.FamilyGuardian.Value"
                @bind-Update="@UpdateRequest.FamilyGuardian.Value"
                State="State"

                Label="Family Guardian"/>
        </MudPaper>
    }
</MudPaper>

@* ReSharper disable Html.IdDuplication *@
@if (!BasicView)
{
    if ((State == ModificationState.Creating && CreateRequest.FamilyGuardian) ||
        (State != ModificationState.Creating && UpdateRequest.FamilyGuardian.Value))
    {
        <MudDivider Class="mb-4"/>
        <PersonContactDetails
            RequestsReadonly
            CreateRequest="CreateRequest"
            UpdateRequest="UpdateRequest"
            Id="Id"
            State="State"/>
    }
    else
    {
        <MudDivider Class="mb-4"/>
        <PersonImpactDetails
            RequestsReadonly
            CreateRequest="CreateRequest"
            UpdateRequest="UpdateRequest"
            ErrorsChanged="ErrorsChanged"
            Id="Id"
            State="State"/>
    }
}

@* Full-screen while it is open, so it sits outside the card's markup rather than inside a column
   of form fields. *@
@if (_capturing)
{
    <PhotoCapture Person="@Entity.Data"
                  OnSaved="@OnPhotoSaved"
                  OnClose="@CloseCapture"/>
}
