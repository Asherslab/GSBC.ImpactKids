@inherits DisplayComponent<Person>

<MudPaper Elevation="6" Class="relative">
    <MudOverlay Visible="@(Entity.IsLoading)"
                DarkBackground="true"
                Absolute="true">
        <MudProgressCircular Indeterminate/>
    </MudOverlay>
    <MudLink Href="@(Id == null ? null : $"/People/{Id}")">
        <MudPaper Elevation="0" Class="d-flex justify-start flex-direction-row flex-grow-0">
            <MudAvatar Rounded Color="@_avatarColor" Class="ma-3">
                @_avatarDisplay
            </MudAvatar>
            <MudPaper Elevation="0" Class="d-flex justify-center flex-column flex-grow-1">
                <MudText>
                    @_displayText
                </MudText>
                @if (Entity.Data != null)
                {
                    <MudText>
                        @(Entity.Data.FamilyGuardian ? "Guardian" : "Child")
                    </MudText>
                }
            </MudPaper>
            <MudPaper Elevation="0" Class="d-flex justify-center flex-column flex-grow-0 mr-5">
                @if (Entity.Data?.GetAge() != null)
                {
                    <MudText Typo="Typo.h6">
                        @Entity.Data?.GetAge()
                    </MudText>
                }
            </MudPaper>
        </MudPaper>
    </MudLink>
</MudPaper>