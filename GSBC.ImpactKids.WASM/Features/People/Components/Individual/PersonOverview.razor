@using GSBC.ImpactKids.WASM.Features.Scripture.Features.Memorisation.Components.Multiple
<MudGrid Spacing="6" Justify="Justify.Center">
    <MudItem xs="12" md="4">
        <MudGrid Spacing="6" Justify="Justify.Center">
            <MudItem xs="12">
                <DetailsModificationCard
                    Id="Id"
                    DetailsComponentType="@(typeof(PersonDetails))"/>
            </MudItem>
            <MudItem xs="12">
                <MudCard Elevation="6" Class="relative">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6"
                                     Align="Align.Start">
                                Memorisation Entries
                            </MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Class="pa-0">
                        <MemorisationEntriesTable
                            ShowService
                            ShowMemoryVerse
                            OnlyExisting

                            PersonId="Id"/>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    </MudItem>
    <MudItem xs="12" md="8">
        <MudGrid Spacing="6" Justify="Justify.FlexStart">
            <MudItem xs="12" md="12">
                <MudCard Elevation="6" Class="relative">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudPaper Elevation="0" Class="d-flex justify-space-between flex-grow-1">
                                <MudText Typo="Typo.h6" Align="Align.Start">Medical Notes</MudText>
                                <MudPaper Elevation="0" Class="d-flex justify-end flex-grow-0">
                                    <MudButton Size="Size.Small" Color="Color.Default"
                                               OnClick="@CreateMedicalNote">
                                        <MudIcon Icon="@Icons.Material.Filled.PostAdd"/>
                                    </MudButton>
                                </MudPaper>
                            </MudPaper>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <ListComponent T="MedicalNote"
                                       Filter="@(x => x.PersonId == Id)"
                                       Context="medicalId">
                            <ChildContent>
                                <MudItem xs="12" lg="6">
                                    <MedicalNoteDisplay AllowUpdating AllowDeleting Id="medicalId"/>
                                </MudItem>
                            </ChildContent>
                            <NoIds>
                                <MudItem xs="12">
                                    <MedicalNoteDisplay None/>
                                </MudItem>
                            </NoIds>
                            <NoData>
                                <MudItem xs="12">
                                    <MedicalNoteDisplay None/>
                                </MudItem>
                            </NoData>
                        </ListComponent>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="12">
                <MudCard Elevation="6" Class="relative">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudPaper Elevation="0" Class="d-flex justify-space-between flex-grow-1">
                                <MudText Typo="Typo.h6" Align="Align.Start">Allergies</MudText>
                                <MudPaper Elevation="0" Class="d-flex justify-end flex-grow-0">
                                    <MudButton Size="Size.Small" Color="Color.Default"
                                               OnClick="@CreateAllergy">
                                        <MudIcon Icon="@Icons.Material.Filled.PostAdd"/>
                                    </MudButton>
                                </MudPaper>
                            </MudPaper>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <ListComponent T="Allergy"
                                       Filter="@(x => x.PersonId == Id)"
                                       Context="allergyId">
                            <ChildContent>
                                <MudItem xs="12" lg="6">
                                    <AllergyDisplay AllowUpdating AllowDeleting Id="allergyId"/>
                                </MudItem>
                            </ChildContent>
                            <NoIds>
                                <MudItem xs="12">
                                    <AllergyDisplay None/>
                                </MudItem>
                            </NoIds>
                            <NoData>
                                <MudItem xs="12">
                                    <AllergyDisplay None/>
                                </MudItem>
                            </NoData>
                        </ListComponent>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="12">
                <MudCard Elevation="6" Class="relative">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6" Align="Align.Start">Family Members</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <ListComponent T="Person"
                                       EnableLoading
                                       Filter="@(x => x.Id == Id)"
                                       SecondaryFilter="@((person, x) => x.FamilyId == person.FamilyId)"
                                       Ordering="@(list => list.OrderByDescending(x => x.FamilyGuardian).ThenBy(x => x.LocalDateOfBirth).ThenBy(x => x.FirstName))"
                                       Context="personId">
                            <MudItem xs="12" lg="6">
                                <PersonDisplay Id="personId" Link/>
                            </MudItem>
                        </ListComponent>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    </MudItem>
</MudGrid>