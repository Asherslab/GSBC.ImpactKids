@inject IRefreshableStore<Person> PeopleStore

<MudGrid Spacing="6" Justify="Justify.Center">
    <MudItem xs="12" md="4">
        <MudGrid Spacing="6" Justify="Justify.Center">
            <MudItem xs="12">
                <MudCard Elevation="6" Class="relative">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudPaper Elevation="0" Class="d-flex justify-space-between flex-grow-1">
                                <MudText Typo="Typo.h6" Align="Align.Start">Details</MudText>
                                <MudPaper Elevation="0" Class="d-flex justify-end flex-grow-0">
                                    <ModificationStateSwitcher
                                        @bind-State="_detailsState"
                                        OnUpdate="UpdatePerson"
                                        OnDelete="DeletePerson"/>
                                </MudPaper>
                            </MudPaper>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <PersonDetails @ref="_personDetailsComponent" Id="Id" State="_detailsState"/>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            @*if (Person?.FamilyGuardian != true)
            {
                <MudItem xs="12">
                    <MudCard Elevation="6" Class="relative">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6" Align="Align.Start">Memorisation Entries</MudText>
                                <MudText Typo="Typo.caption" Align="Align.Start">For current term</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <VerseMemorisationEntries
                                ShowMemoryVerse
                                ShowService
                                MemorisationEntries="MemorisationEntries"/>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }*@
        </MudGrid>
    </MudItem>
    <MudItem xs="12" md="8">
        <MudGrid Spacing="6" Justify="Justify.FlexStart">
            <MudItem xs="12" md="6">
                <MudCard Elevation="6" Class="relative">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudPaper Elevation="0" Class="d-flex justify-space-between flex-grow-1">
                                <MudText Typo="Typo.h6" Align="Align.Start">Medical Notes</MudText>
                                <MudPaper Elevation="0" Class="d-flex justify-end flex-grow-0">
                                    @if (!_creatingMedicalNote)
                                    {
                                        <MudButton Size="Size.Small" Color="Color.Default"
                                                   OnClick="@(_ => _creatingMedicalNote = true)">
                                            <MudIcon Icon="@Icons.Material.Filled.PostAdd"/>
                                        </MudButton>
                                    }
                                    else
                                    {
                                        <MudButton Size="Size.Small" Color="Color.Error"
                                                   OnClick="@(_ => _creatingMedicalNote = false)">
                                            Cancel
                                        </MudButton>
                                        <MudButton Size="Size.Small" Color="Color.Success" OnClick="@CreateMedicalNote">
                                            Submit
                                        </MudButton>
                                    }
                                </MudPaper>
                            </MudPaper>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        @if (_creatingMedicalNote && Id != null)
                        {
                            <CreateMedicalNote @ref="_createMedicalNoteComponent"
                                               @bind-MedicalTypes="_medicalTypes"
                                               PersonId="Id.Value"/>
                            <MudDivider Class="my-6"/>
                        }
                        <MedicalNotesList PersonId="Id"/>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudCard Elevation="6" Class="relative">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudPaper Elevation="0" Class="d-flex justify-space-between flex-grow-1">
                                <MudText Typo="Typo.h6" Align="Align.Start">Allergies</MudText>
                                <MudPaper Elevation="0" Class="d-flex justify-end flex-grow-0">
                                    @if (!_creatingAllergy)
                                    {
                                        <MudButton Size="Size.Small" Color="Color.Default"
                                                   OnClick="@(_ => _creatingAllergy = true)">
                                            <MudIcon Icon="@Icons.Material.Filled.PostAdd"/>
                                        </MudButton>
                                    }
                                    else
                                    {
                                        <MudButton Size="Size.Small" Color="Color.Error"
                                                   OnClick="@(_ => _creatingAllergy = false)">
                                            Cancel
                                        </MudButton>
                                        <MudButton Size="Size.Small" Color="Color.Success" OnClick="@CreateAllergy">
                                            Submit
                                        </MudButton>
                                    }
                                </MudPaper>
                            </MudPaper>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        @if (_creatingAllergy && Id != null)
                        {
                            <CreateAllergy @ref="_createAllergyComponent"
                                           @bind-Allergens="_allergens"
                                           PersonId="Id.Value"/>
                            <MudDivider Class="my-6"/>
                        }
                        <AllergiesList PersonId="Id"/>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="12">
                <MudCard Elevation="6" Class="relative">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6" Align="Align.Start">Family Members</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <PeopleList FamilyOfId="Id"/>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    </MudItem>
</MudGrid>