<MudGrid Spacing="6" Justify="Justify.Center">
    <MudItem xs="12" md="4">
        <MudGrid Spacing="6" Justify="Justify.Center">
            <MudItem xs="12">
                <DetailsModificationCard
                    Id="Id"
                    DetailsComponentType="@(typeof(PersonDetails))"
                    ExtraParameters="_personDetailsExtraParams"/>
            </MudItem>
            @if (!HideMemorisationEntries)
            {
                <MudItem xs="12">
                    <MudCard Elevation="6" Class="relative">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6"
                                         Align="Align.Start">
                                    Memorisation Entries
                                </MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent Class="pa-0">
                            <MemorisationEntriesTable
                                ShowService
                                ShowMemoryVerse
                                OnlyExisting

                                PersonId="Id"/>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    </MudItem>
    <MudItem xs="12" md="8">
        <MudGrid Spacing="6" Justify="Justify.FlexStart">
            <MudItem xs="12" md="12">
                <MedicalNotesCard PersonId="Id" NoIdsChanged="@MedicalNotesNoIdsChanged"/>
            </MudItem>
            <MudItem xs="12" md="12">
                <AllergiesCard PersonId="Id" NoIdsChanged="@AllergiesNoIdsChanged"/>
            </MudItem>
            @if (!HideFamilyMembers)
            {
                <MudItem xs="12" md="12">
                    <MudCard Elevation="6" Class="relative">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6" Align="Align.Start">Family Members</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <ListComponent T="Person"
                                           EnableLoading
                                           Filter="@(x => x.Id == Id)"
                                           SecondaryFilter="@((person, x) => x.FamilyId == person.FamilyId)"
                                           Ordering="@(list => list.OrderByDescending(x => x.FamilyGuardian).ThenBy(x => x.LocalDateOfBirth).ThenBy(x => x.FirstName))"
                                           Context="personId">
                                <MudItem xs="12" lg="6">
                                    <PersonDisplay Id="personId" ShowPersonLink/>
                                </MudItem>
                            </ListComponent>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    </MudItem>
</MudGrid>