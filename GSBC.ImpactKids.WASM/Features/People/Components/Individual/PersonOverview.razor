@using GSBC.ImpactKids.WASM.Features.Scripture.Memorisation.Components.Multiple
@inject ISnackbar Snackbar

<MudGrid Spacing="6" Justify="Justify.Center">
    <MudItem xs="12" md="4">
        <MudGrid Spacing="6" Justify="Justify.Center">
            <MudItem xs="12">
                <MudCard Elevation="6" Class="relative">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudPaper Elevation="0" Class="d-flex justify-space-between flex-grow-1">
                                <MudText Typo="Typo.h6" Align="Align.Start">Details</MudText>
                                <MudPaper Elevation="0" Class="d-flex justify-end flex-grow-0">
                                    @if (!_editingDetails)
                                    {
                                        <MudButton Size="Size.Small" Color="Color.Error">
                                            <MudIcon Icon="@Icons.Material.Filled.Delete"/>
                                        </MudButton>
                                        <MudButton Size="Size.Small" Color="Color.Default"
                                                   OnClick="@(_ => _editingDetails = true)">
                                            <MudIcon Icon="@Icons.Material.Filled.Edit"/>
                                        </MudButton>
                                    }
                                    else
                                    {
                                        <MudButton Size="Size.Small" Color="Color.Error"
                                                   OnClick="@(_ => _editingDetails = false)">
                                            Cancel
                                        </MudButton>
                                        <MudButton Size="Size.Small" Color="Color.Success" OnClick="@UpdatePerson">
                                            Submit
                                        </MudButton>
                                    }
                                </MudPaper>
                            </MudPaper>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <PersonDetails @ref="_personDetailsComponent" Person="Person" Editing="_editingDetails"/>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            @if (Person?.FamilyGuardian != true)
            {
                <MudItem xs="12">
                    <MudCard Elevation="6" Class="relative">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6" Align="Align.Start">Memorisation Entries</MudText>
                                <MudText Typo="Typo.caption" Align="Align.Start">For current term</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <VerseMemorisationEntries
                                ShowMemoryVerse
                                ShowService
                                MemorisationEntries="MemorisationEntries"/>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    </MudItem>
    <MudItem xs="12" md="8">
        <MudGrid Spacing="6" Justify="Justify.FlexStart">
            <MudItem xs="12" md="6">
                <MudCard Elevation="6" Class="relative">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6" Align="Align.Start">Medical Notes</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MedicalNotesDetails MedicalNotes="Person?.MedicalNotes"/>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudCard Elevation="6" Class="relative">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6" Align="Align.Start">Allergies</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <AllergiesDetails Allergies="Person?.Allergies"/>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="12">
                <MudCard Elevation="6" Class="relative">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6" Align="Align.Start">Family Members</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <FamilyMembers Members="@FamilyMembers"/>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    </MudItem>
</MudGrid>