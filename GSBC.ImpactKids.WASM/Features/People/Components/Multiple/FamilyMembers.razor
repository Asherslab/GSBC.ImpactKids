<MudOverlay Visible="@_waitingForUpdate" DarkBackground="true" Absolute="true">
    <MudProgressCircular Indeterminate/>
</MudOverlay>
@if (_familyMembers != null)
{
    <MudGrid Spacing="6" Justify="Justify.Center">
        @foreach (Person member in _familyMembers)
        {
            <MudItem xs="12" md="6">
                <PersonDisplay Person="member"/>
            </MudItem>
        }
    </MudGrid>
}
else
{
    <MudGrid Spacing="6" Justify="Justify.Center">
        @foreach (int _ in Enumerable.Range(0, 5))
        {
            <MudItem xs="12" md="6">
                <PersonDisplay None/>
            </MudItem>
        }
    </MudGrid>
}