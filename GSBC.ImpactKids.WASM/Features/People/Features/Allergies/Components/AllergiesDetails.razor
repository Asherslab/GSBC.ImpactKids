<MudOverlay Visible="@_waitingForUpdate" DarkBackground="true" Absolute="true">
    <MudProgressCircular Indeterminate/>
</MudOverlay>
@if (_allergies != null && _allergies.Count != 0)
{
    <MudGrid Spacing="6" Justify="Justify.FlexStart">
        @foreach (Allergy allergy in _allergies)
        {
            <MudItem md="12" lg="6">
                <AllergyDisplay Allergy="allergy" AllowDeleting/>
            </MudItem>
        }
    </MudGrid>
}
else
{
    <MudGrid Spacing="6" Justify="Justify.FlexStart">
        <MudItem xs="12">
            <AllergyDisplay None/>
        </MudItem>
    </MudGrid>
}