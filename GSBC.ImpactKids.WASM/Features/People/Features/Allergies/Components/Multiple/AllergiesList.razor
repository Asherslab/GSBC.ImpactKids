@inject IRefreshableStore<Allergy> AllergiesStore

<MudOverlay Visible="_allergyIds.IsLoading" DarkBackground="true" Absolute="true">
    <MudProgressCircular Indeterminate/>
</MudOverlay>
@if (_allergyIds.Data != null && _allergyIds.Data.Count != 0)
{
    <MudGrid Spacing="6" Justify="Justify.Center">
        @foreach (Guid allergyId in _allergyIds.Data)
        {
            <MudItem md="12" lg="6">
                <AllergyDisplay Id="allergyId" AllowDeleting/>
            </MudItem>
        }
    </MudGrid>
}
else
{
    <MudGrid Spacing="6" Justify="Justify.FlexStart">
        <MudItem xs="12">
            <AllergyDisplay None/>
        </MudItem>
    </MudGrid>
}