@inject IRefreshableStore<Allergy>  AllergiesStore
@inject IRefreshableStore<Allergen> AllergensStore
@inject IAllergyService             AllergyService
@inject ISnackbar                   Snackbar

<MudOverlay Visible="_allergy.IsLoading" DarkBackground="true" Absolute="true">
    <MudProgressCircular Indeterminate/>
</MudOverlay>
<MudPaper Elevation="6" Class="d-flex justify-start flex-row flex-grow-1">
    <MudAvatar Rounded Color="_avatarColor" Class="ma-3">
        @if (_avatarDisplay == null)
        {
            <MudProgressCircular Indeterminate/>
        }
        else
        {
            @_avatarDisplay
        }
    </MudAvatar>
    <MudPaper Elevation="0" Class="d-flex justify-center flex-column flex-grow-1">
        <MudText>
            @_displayText
        </MudText>
        @if (_allergy.Data?.Notes != null)
        {
            <MudText Typo="Typo.caption">
                @(_allergy.Data.Notes)
            </MudText>
        }
    </MudPaper>
    @if (AllowDeleting)
    {
        <MudPaper Elevation="0" Class="d-flex justify-end">
            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                           OnClick="@OnDelete"/>
        </MudPaper>
    }
</MudPaper>