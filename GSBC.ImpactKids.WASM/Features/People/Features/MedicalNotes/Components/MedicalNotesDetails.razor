<MudOverlay Visible="@_waitingForUpdate" DarkBackground="true" Absolute="true">
    <MudProgressCircular Indeterminate/>
</MudOverlay>
@if (_medicalNotes != null && _medicalNotes.Count != 0)
{
    <MudGrid Spacing="6" Justify="Justify.FlexStart">
        @foreach (MedicalNote note in _medicalNotes)
        {
            <MudItem lg="12" xl="6">
                <MedicalNoteDisplay MedicalNote="note" AllowDeleting/>
            </MudItem>
        }
    </MudGrid>
}
else
{
    <MudGrid Spacing="6" Justify="Justify.FlexStart">
        <MudItem xs="12">
            <MedicalNoteDisplay None/>
        </MudItem>
    </MudGrid>
}