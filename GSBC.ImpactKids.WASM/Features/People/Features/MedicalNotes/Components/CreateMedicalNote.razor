@using GSBC.ImpactKids.Shared.Contracts.Entities.Features.People.MedicalNotes
@inject IMedicalTypeService MedicalTypeService
@inject IMedicalNoteService MedicalNoteService
@inject ISnackbar           Snackbar

<MudPaper Elevation="0" Class="d-flex flex-column flex-grow-1">
    <MudOverlay Visible="@(MedicalTypes == null || _creatingMedicalNote)" DarkBackground="true" Absolute="true">
        <MudProgressCircular Indeterminate/>
    </MudOverlay>

    <MudPaper Elevation="0" Class="d-flex flex-row flex-grow-1 mb-4">
        @if (MedicalTypes != null)
        {
            <MudSelect T="Guid?"
                       @bind-Value="@_createRequest.MedicalTypeId"
                       Label="Medical Type"
                       Variant="Variant.Filled"
                       Clearable>
                @foreach (MedicalType medicalType in MedicalTypes)
                {
                    <MudSelectItem T="Guid?" Value="@medicalType.Id">@medicalType.Label</MudSelectItem>
                }
            </MudSelect>
        }
        <MudCheckBox
            @bind-Value="@_createRequest.Severe"
            Label="Severe"/>
    </MudPaper>
    
    <MudTextField
        @bind-Value="@_createRequest.Notes"
        Label="Optional Notes"
        Immediate
        Variant="Variant.Filled"
        Lines="3"/>
</MudPaper>