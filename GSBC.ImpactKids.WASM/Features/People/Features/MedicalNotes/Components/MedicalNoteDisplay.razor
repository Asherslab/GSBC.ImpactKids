@inject IMedicalNoteService MedicalNoteService
@inject ISnackbar           Snackbar

<MudOverlay Visible="@_hasBeenDeleted" DarkBackground="true" Absolute="true">
    <MudProgressCircular Indeterminate/>
</MudOverlay>
<MudPaper Elevation="6" Class="d-flex justify-start flex-row flex-grow-1">
    <MudAvatar Rounded Color="@AvatarColor()" Class="ma-3">
        @if (AvatarDisplay() == null)
        {
            <MudProgressCircular Indeterminate/>
        }
        else
        {
            @AvatarDisplay()
        }
    </MudAvatar>
    <MudPaper Elevation="0" Class="d-flex justify-center flex-column flex-grow-1">
        <MudText>
            @DisplayText()
        </MudText>
        @if (MedicalNote?.Notes != null)
        {
            <MudText Typo="Typo.caption">
                @(MedicalNote.Notes)
            </MudText>
        }
    </MudPaper>
    @if (AllowDeleting)
    {
        <MudPaper Elevation="0" Class="d-flex justify-end">
            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                           OnClick="@OnDelete"/>
        </MudPaper>
    }
</MudPaper>