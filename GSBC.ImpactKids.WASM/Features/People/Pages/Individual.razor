@page "/People/{Id:guid}"
@inject IRefreshableStore<Person>   PeopleStore

<PageTitle>@(_person.Data?.GetDisplayName() ?? "Person")</PageTitle>

<MudPaper Elevation="6" Class="mt-4 px-6 pb-6">
    <MudText Align="Align.Center" Typo="Typo.h5" Class="py-3">@(_person.Data?.GetDisplayName() ?? "Person")</MudText>
    <PersonOverview
        Id="Id"/>
</MudPaper>