@inherits EventListeningComponent
@page "/People/{Id:guid}"
@inject IPersonService              PersonService
@inject IMemorisationEntriesService MemorisationEntriesService

<PageTitle>@(_person == null ? "Person" : _person.FirstName + " " + _person.LastName)</PageTitle>

<MudPaper Elevation="6" Class="mt-4 px-6 pb-6">
    @if (_person != null)
    {
        <MudText Align="Align.Center" Typo="Typo.h5" Class="py-3">@_person.FirstName @_person.LastName</MudText>
    }
    else
    {
        <MudText Align="Align.Center" Typo="Typo.h5" Class="py-3">Person</MudText>
    }
    <PersonOverview Person="_person" FamilyMembers="_familyMembers" MemorisationEntries="_memorisationEntries"/>
</MudPaper>