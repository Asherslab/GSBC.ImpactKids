@inherits EntityUtilityComponent
@inject IRefreshableStore<AttendanceRecord> AttendanceRecordsStore
@inject IRefreshableStore<Person>           PeopleStore
@inject IRefreshableStore<User>             UsersStore

@* Plain elements, not MudStack/MudText: CSS isolation stamps its b-hash only on this
   component's own markup, so a class on a MudBlazor component never matches its rule. *@
<div class="log">
    @if (_entries.IsLoading)
    {
        <div class="log-empty">
            <MudProgressCircular Indeterminate Size="Size.Small"/>
        </div>
    }
    else if (_entries.HasError)
    {
        <MudAlert Severity="Severity.Error" Dense>
            @(_entries.Error ?? "An Unexpected error occured")
        </MudAlert>
    }
    else if (_entries.HasData && _entries.Data!.Count == 0)
    {
        <div class="log-empty">
            <MudText Typo="Typo.body2">Nothing yet this service.</MudText>
        </div>
    }
    else if (_entries.HasData)
    {
        <div class="log-rows">
            @foreach (ActivityEntry entry in _entries.Data!)
            {
                <div class="log-row">
                    <span class="log-time">@entry.Time</span>
                    @* A plain anchor, not MudLink: the scoped rule below only matches this
                       component's own markup, and Blazor's router intercepts a same-origin
                       href so this still navigates without a page load. *@
                    <a class="log-name" href="@entry.Href">@entry.PersonName</a>
                    <span class="log-action log-action--@entry.ActionClass">@entry.Action</span>
                    @if (entry.ActorName != null)
                    {
                        <span class="log-actor">@entry.ActorName</span>
                    }
                </div>
            }
        </div>
    }
</div>
