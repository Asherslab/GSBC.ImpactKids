@inherits DisplayComponent<AttendanceItemRecord>
@inject IRefreshableStore<AttendanceItemType> AttendanceItemTypesStore

<MudPaper Elevation="6" Class="relative">
    <MudOverlay Visible="@(Entity.IsLoading || _attendanceItemType.IsLoading)" DarkBackground="true" Absolute="true">
        <MudProgressCircular Indeterminate/>
    </MudOverlay>
    <MudLink Underline="Underline.None" Href="@Href">
        <MudPaper Elevation="0" Class="@Css">
            <MudAvatar Rounded Color="_avatarColor" Class="ma-3">
                <MudIcon Color="Color.Surface" Icon="@_avatarDisplay"/>
            </MudAvatar>
            <MudPaper Elevation="0" Class="d-flex justify-center flex-column flex-grow-1">
                <MudText>
                    @_displayText
                </MudText>
                @if (Entity.Data?.Notes != null)
                {
                    <MudText Typo="Typo.caption">
                        @(Entity.Data.Notes)
                    </MudText>
                }
            </MudPaper>
            <MudPaper Elevation="0" Class="d-flex justify-center flex-column flex-grow-0 mr-5">
                @if (SuffixContent != null)
                {
                    @SuffixContent(Entity.Data)
                }
            </MudPaper>
        </MudPaper>
    </MudLink>
</MudPaper>