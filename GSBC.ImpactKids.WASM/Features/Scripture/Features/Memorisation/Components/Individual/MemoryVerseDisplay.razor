<MudLink Underline="Underline.None"
         Href="@Href">
    @if (ShowReference && !ShowOriginalText && !ShowVerseText)
    {
        <MudPaper Elevation="Elevation"
                  Class="@ReferenceOnlyClass">
            <MudText Typo="Typo.body1" Class="ma-3">
                @(MemoryVerse?.ReferenceName ?? "Memory Verse")
            </MudText>
        </MudPaper>
    }
    else
    {
        <MudCard Elevation="Elevation" Class="relative">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudPaper Elevation="0" Class="d-flex justify-space-between flex-grow-1">
                        <MudText Typo="Typo.h6" Align="Align.Start">
                            @(MemoryVerse?.ReferenceName ?? "Memory Verse")
                        </MudText>
                    </MudPaper>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudOverlay Visible="@(MemoryVerse == null)" DarkBackground="true" Absolute="true">
                    <MudProgressCircular Indeterminate/>
                </MudOverlay>
                @if (ShowVerseText)
                {
                    <MudText>
                        @(MemoryVerse?.Verse ?? "Verse....")
                    </MudText>
                }
            </MudCardContent>
        </MudCard>
    }
</MudLink>