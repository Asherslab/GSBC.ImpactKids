@inherits DisplayComponent<MemoryVerse>

<MudPaper Elevation="6" Class="relative">
    <MudOverlay Visible="@(Entity.IsLoading)" DarkBackground="true" Absolute="true">
        <MudProgressCircular Indeterminate/>
    </MudOverlay>
    <MudLink Underline="Underline.None"
             Href="@Href">
        <MudPaper Elevation="0"
                  Class="@ReferenceOnlyClass">
            <MudText Typo="Typo.body1" Class="ma-3">
                @(Entity.Data?.ReferenceName ?? "Memory Verse")
            </MudText>
        </MudPaper>
    </MudLink>
</MudPaper>