@using GSBC.ImpactKids.WASM.Pages.VerseMemorisation
<MudOverlay Visible="@_waitingForUpdate" DarkBackground="true" Absolute="true">
    <MudProgressCircular Indeterminate/>
</MudOverlay>
@if (_memoryVerses != null)
{
    <MudStack>
        @foreach (MemoryVerse memoryVerse in _memoryVerses)
        {
            <MemoryVerseDisplay ShowReference
                                Href="@(ServiceId == null ? null : $"/VerseMemorisation/{ServiceId}?{nameof(MemorisationComponent.SelectedMemoryVerse)}={memoryVerse.Id}")"
                                MemoryVerse="memoryVerse"/>
        }
    </MudStack>
}
else
{
    <MudStack>
        @foreach (int _ in Enumerable.Range(0, 3))
        {
            <MemoryVerseDisplay ShowReference/>
        }
    </MudStack>
}