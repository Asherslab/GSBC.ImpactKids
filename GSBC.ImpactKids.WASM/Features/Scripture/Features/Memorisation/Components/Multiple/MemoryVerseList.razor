@inject IRefreshableStore<MemoryVerse> MemoryVersesStore

@using GSBC.ImpactKids.WASM.Pages.VerseMemorisation
<MudOverlay Visible="@(_memoryVerseIds.IsNotAsked || _memoryVerseIds.IsLoading)" DarkBackground="true" Absolute="true">
    <MudProgressCircular Indeterminate/>
</MudOverlay>
@if (_memoryVerseIds.Data != null)
{
    <MudStack>
        @foreach (Guid id in _memoryVerseIds.Data)
        {
            <MemoryVerseDisplay ShowReference
                                Href="@(ServiceId == null ? null : $"/VerseMemorisation/{ServiceId}?{nameof(MemorisationComponent.SelectedMemoryVerse)}={id}")"
                                Id="id"/>
        }
    </MudStack>
}
else
{
    <MudStack>
        @foreach (int _ in Enumerable.Range(0, 3))
        {
            <MemoryVerseDisplay ShowReference/>
        }
    </MudStack>
}