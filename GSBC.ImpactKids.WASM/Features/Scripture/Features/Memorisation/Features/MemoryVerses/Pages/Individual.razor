@inherits DisplayComponent<MemoryVerse>
@page "/MemoryVerses/{Id:guid}"

<PageTitle>@(Entity.Data?.ReferenceName ?? "Memory Verse")</PageTitle>

<MudPaper Elevation="6" Class="mt-4 pt-1 px-6 pb-6">
    <MudText Align="Align.Center" Typo="Typo.h5" Class="py-3">@(Entity.Data?.ReferenceName ?? "Memory Verse")</MudText>
    @if (Entity.HasError)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">
            @(Entity.Error ?? "An Unexpected error occured")
        </MudAlert>
    }
    <MemoryVerseOverview Id="Id"/>
</MudPaper>