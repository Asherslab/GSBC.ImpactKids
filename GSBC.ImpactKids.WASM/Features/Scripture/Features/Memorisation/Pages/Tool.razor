@inherits StoreComponent<MemorisationToolState>
@page "/Scripture/Memorisation/Tool/{ServiceId:guid}"
@inject IRefreshableStore<Service> ServicesStore

<PageTitle>Memorisation Tools</PageTitle>

<MudPaper Elevation="6" Class="mt-4 pt-1 px-6 pb-6">
    <MudText Align="Align.Center" Typo="Typo.h5" Class="py-3">Verse Memorisation Tool</MudText>
    @if (_service.HasError)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">
            @(_service.Error ?? "An Unexpected error occured")
        </MudAlert>
    }
    <MemorisationTool
        ServiceId="_service.Data?.Id"
        MemoryVerseId="@State.MemoryVerseId"
        MemoryVerseIdChanged="OnMemoryVerseIdChanged"/>
</MudPaper>