@inherits ReadOnlyDetailsComponent<BibleVerse>

<MudPaper Elevation="0" Class="d-flex flex-column flex-grow-1">
    <MudOverlay Visible="@(Entity.IsLoading)"
                DarkBackground="true"
                Absolute="true">
        <MudProgressCircular Indeterminate/>
    </MudOverlay>
    @if (Entity.HasError)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">
            @(Entity.Error ?? "An Unexpected error occured")
        </MudAlert>
    }
    <MudTextFieldCreateOrUpdate
        Read="@Entity.Data?.Reference()"
        State="State"

        Class="mb-4"
        Label="Reference"
        Variant="Variant.Filled"
        Immediate/>
    <MudTextFieldCreateOrUpdate
        Read="@Entity.Data?.Verse"
        State="State"

        Lines="5"
        Class="mb-4"
        Label="Verse"
        Variant="Variant.Filled"
        Immediate/>
</MudPaper>