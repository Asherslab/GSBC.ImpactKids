@inherits DisplayComponent<BibleVerse>

<MudPaper Elevation="6" Class="relative">
    <MudOverlay Visible="@(Entity.IsLoading)" DarkBackground="true" Absolute="true">
        <MudProgressCircular Indeterminate/>
    </MudOverlay>
    <MudLink Underline="Underline.None" OnClick="@OpenDialog">
        <MudPaper Elevation="0"
                  Class="@Class">
            <MudText Typo="Typo.body1" Class="ma-3 flex-grow-1">
                @(Entity.Data?.Reference() ?? "Bible Verse")
            </MudText>
            @if (AllowDeleting)
            {
                <MudPaper Elevation="0" Class="d-flex justify-end">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   OnClick="@DeleteClicked"/>
                </MudPaper>
            }
        </MudPaper>
    </MudLink>
</MudPaper>