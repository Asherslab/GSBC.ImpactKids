@page "/Games/Scores"
@using GSBC.ImpactKids.Shared.Contracts.Entities.Features.Games
@using GSBC.ImpactKids.Shared.Contracts.Entities.Features.Scheduling
@using GSBC.ImpactKids.WASM.Features.Games
@using GSBC.ImpactKids.WASM.Features.Games.Components
@using GSBC.ImpactKids.WASM.Features.Games.Services
@attribute [Authorize]
@inherits EntityUtilityComponent
@inject IRefreshableStore<Service> ServicesStore
@inject IGamePointsService         Points

<PageTitle>Totals</PageTitle>

@* Capped width on a phone - stretched wide the team name and its score ended up a screen
   apart - but the table wants the room, so the cap lifts with it. A plain wrapper,
   because scoped CSS does not reach a MudBlazor component's root. *@
<div class="scores-page">
<MudStack Spacing="2">
    <MudStack Row Class="align-center justify-space-between flex-wrap gap-2">
        <MudText Typo="Typo.h6">Totals</MudText>
        <MudStack Row Class="align-center gap-1">
            <MudIconButton Icon="@Icons.Material.Filled.SportsEsports"
                           Title="Back to scoring"
                           Href="/Games/Points"/>
            <MudIconButton Icon="@Icons.Material.Filled.Cast"
                           Title="Open wall display"
                           Href="/Display/Scores"
                           Target="_blank"/>
        </MudStack>
    </MudStack>

    @if (_service.Data == null)
    {
        <MudAlert Severity="Severity.Warning" Dense>
            @(_service.Error ?? "Finding today's service...")
        </MudAlert>
    }
    else
    {
        <MudText Typo="Typo.caption" Class="mud-text-secondary">
            @_service.Data.GetDisplayName() — @_service.Data.LocalDate.ToString("ddd d MMM")
        </MudText>

        @* Worked out once - every row needs the whole table to know its placing.
           Declared out here rather than inside a tab: a bare C# statement in a panel's
           child content is markup, and would print itself on the page. *@
        IReadOnlyList<TeamStanding> standings = Standings;

        @* Two jobs, two tabs. The night's scores and the reveal remote are what this page
           is for on an ordinary week; setting a night up in advance is a different job with
           a screenful of its own, and stacking both down one page is what left a game being
           edited in two places at once.

           Tabs rather than the chip pair used below for the points mode: those chips change
           how a number reads, these change what you are doing, and two rows of chips
           meaning different things is how a page stops being readable. *@
        <MudTabs Elevation="0" ApplyEffectsToContainer PanelClass="pt-4" Rounded>
            <MudTabPanel Text="Scores" Icon="@Icons.Material.Filled.Leaderboard">
        @* The reveal plays on a screen nobody can reach, so every control for it lives
           here - this page is the remote. *@
        <MudPaper Elevation="2" Class="pa-3 reveal-control">
            <MudStack Spacing="2">
                <MudStack Row Class="align-center justify-space-between">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.subtitle2"><b>Final score reveal</b></MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @RevealStatus
                        </MudText>
                    </MudStack>
                    <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                   Title="Open the reveal display"
                                   Href="@RevealDisplayHref"
                                   Target="_blank"/>
                </MudStack>

                @if (Board.Hidden)
                {
                    <MudAlert Severity="Severity.Warning" Dense>
                        Scores are hidden, so the display will hold instead of playing the reveal.
                    </MudAlert>
                }

                @if (!RevealRunning)
                {
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Large"
                               FullWidth
                               StartIcon="@Icons.Material.Filled.PlayArrow"
                               Disabled="@(RevealSteps.Count == 0)"
                               OnClick="StartReveal">
                        Start reveal
                    </MudButton>
                }
                else
                {
                    <MudText Typo="Typo.h6" Class="reveal-step">@RevealStepLabel</MudText>

                    @* Driven from a phone, in the dark, one handed - the advance button is
                       deliberately the biggest thing on the page. *@
                    <MudStack Row Spacing="2">
                        <MudIconButton Icon="@Icons.Material.Filled.SkipPrevious"
                                       Variant="Variant.Outlined"
                                       Size="Size.Large"
                                       Title="Back a step"
                                       Disabled="@(RevealIndex == 0)"
                                       OnClick="PreviousRevealStep"/>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Large"
                                   Class="flex-grow-1 reveal-next"
                                   EndIcon="@Icons.Material.Filled.SkipNext"
                                   Disabled="@(RevealIndex >= RevealSteps.Count - 1)"
                                   OnClick="NextRevealStep">
                            @(RevealIndex >= RevealSteps.Count - 1 ? "That's the lot" : "Next")
                        </MudButton>
                    </MudStack>

                    <MudStack Row Spacing="2">
                        <MudButton Variant="Variant.Text"
                                   StartIcon="@Icons.Material.Filled.Replay"
                                   OnClick="RestartReveal">
                            Restart
                        </MudButton>
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.Stop"
                                   OnClick="EndReveal">
                            End reveal
                        </MudButton>
                    </MudStack>
                }
            </MudStack>
        </MudPaper>

        <MudStack Row Class="align-center flex-wrap gap-1 scores-modes">
            <MudChip T="string"
                     Size="Size.Small"
                     Icon="@Icons.Material.Filled.Cast"
                     Variant="@(_showMultiplied ? Variant.Filled : Variant.Outlined)"
                     Color="@(_showMultiplied ? Color.Primary : Color.Default)"
                     OnClick="@(() => _showMultiplied = true)">
                Display points
            </MudChip>
            <MudChip T="string"
                     Size="Size.Small"
                     Icon="@Icons.Material.Filled.TouchApp"
                     Variant="@(_showMultiplied ? Variant.Outlined : Variant.Filled)"
                     Color="@(_showMultiplied ? Color.Default : Color.Primary)"
                     OnClick="@(() => _showMultiplied = false)">
                Scored points
            </MudChip>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                @(_showMultiplied
                    ? "As the screens show them."
                    : "As they were tapped in. Placings still follow the display points.")
            </MudText>
        </MudStack>

        @* Table on a desktop, where comparing one game against another is the whole point
           of the page. The cards below are the same numbers for a phone.
           Both wrappers are plain elements: scoped CSS never reaches a MudBlazor
           component's root, so hiding one of them off a class on MudPaper would do
           nothing at all and leave both on screen. *@
        <div class="totals-table-wrap">
            <MudPaper Elevation="2" Class="pa-1">
            <table class="totals-table">
                <thead>
                    <tr>
                        <th class="totals-place">#</th>
                        <th class="totals-team">Team</th>
                        @* Columns are the games that count - a planned or voided game has no
                           column at all, which is what makes the row add up to the total. *@
                        @foreach (int number in CountingGames)
                        {
                            int game = number;

                            <th class="totals-number">
                                <span class="totals-head-name">@GameLabel(game)</span>
                                @if (_showMultiplied)
                                {
                                    <span class="totals-head-sub">×@Board.MultiplierFor(game)</span>
                                }
                            </th>
                        }
                        <th class="totals-number">
                            <span class="totals-head-name">Behaviour</span>
                            @if (_showMultiplied)
                            {
                                <span class="totals-head-sub">×@Board.BehaviourMultiplier()</span>
                            }
                        </th>
                        <th class="totals-number totals-total">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (TeamStanding standing in standings)
                    {
                        <tr class="@(PlaceOf(standing, standings) == 1 ? "totals-row-leader" : "")">
                            <td class="totals-place">@PlacingLabel(standing, standings)</td>
                            <th scope="row" class="totals-team" style="@($"--team: {standing.Team.Colour};")">
                                @standing.Team.Name
                            </th>
                            @for (int position = 0; position < CountingGames.Count; position++)
                            {
                                int at = position;

                                <td class="totals-number @(standing.PerGame[at] == 0 ? "totals-zero" : "")">
                                    @Format(GameValue(standing, at))
                                </td>
                            }
                            <td class="totals-number @(standing.Behaviour == 0 ? "totals-zero" : "")">
                                @Format(BehaviourValue(standing))
                            </td>
                            <td class="totals-number totals-total">@Format(TotalValue(standing))</td>
                        </tr>
                    }
                </tbody>
                @if (CountingGames.Count > 0)
                {
                    @* Every team's haul in a game, so a game that is running away with the
                       night is obvious without reading down the column. *@
                    <tfoot>
                        <tr>
                            <td class="totals-place"></td>
                            <th scope="row" class="totals-team">All teams</th>
                            @for (int position = 0; position < CountingGames.Count; position++)
                            {
                                int at = position;

                                <td class="totals-number">@Format(GameTotal(standings, at))</td>
                            }
                            <td class="totals-number">@Format(BehaviourTotal(standings))</td>
                            <td class="totals-number totals-total">@Format(GrandTotal(standings))</td>
                        </tr>
                    </tfoot>
                }
            </table>
            </MudPaper>
        </div>

        <div class="totals-cards">
        <MudStack Spacing="1">
            @foreach (TeamStanding standing in standings)
            {
                <MudPaper Elevation="2"
                          Class="pa-3 standing"
                          Style="@($"border-left: 6px solid {standing.Team.Colour};")">
                    <MudStack Row Class="align-center justify-space-between">
                        <MudStack Row Class="align-center gap-2">
                            <span class="standing-rank">@PlacingLabel(standing, standings)</span>
                            <MudText Typo="Typo.subtitle1"><b>@standing.Team.Name</b></MudText>
                        </MudStack>
                        <MudText Typo="Typo.h5"><b>@Format(TotalValue(standing))</b></MudText>
                    </MudStack>

                    <div class="standing-breakdown">
                        @for (int position = 0; position < CountingGames.Count; position++)
                        {
                            int at = position;

                            <span class="standing-chip">
                                <span class="standing-chip-label">@GameLabel(CountingGames[at])</span>
                                <span class="standing-chip-value">@Format(GameValue(standing, at))</span>
                            </span>
                        }
                        <span class="standing-chip standing-chip-behaviour">
                            <span class="standing-chip-label">Behaviour</span>
                            <span class="standing-chip-value">@Format(BehaviourValue(standing))</span>
                        </span>
                    </div>
                </MudPaper>
            }
        </MudStack>
        </div>
            </MudTabPanel>

            @* Everything about how the night is put together - the multipliers, the teams,
               and one card per game. Its own component: a game is one thing and deserves
               one home. *@
            <MudTabPanel Text="Set up" Icon="@Icons.Material.Filled.Tune">
                <GameSetup ServiceId="@ServiceKey"/>
            </MudTabPanel>
        </MudTabs>
    }
</MudStack>
</div>
