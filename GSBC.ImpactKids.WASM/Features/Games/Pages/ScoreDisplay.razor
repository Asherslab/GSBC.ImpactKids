@page "/Display/Scores"
@page "/Display/Scores/{ServiceId:guid}"
@using GSBC.ImpactKids.Shared.Contracts.Entities.Features.Games
@using GSBC.ImpactKids.WASM.Features.Games.Layout
@layout DisplayLayout
@inherits GSBC.ImpactKids.WASM.Features.Games.Components.ScoreboardWatcherComponent
@* Overrides the blanket [Authorize] in Features/_Imports.razor. A screen on a wall
   cannot sign in, and this page only ever renders aggregate scores. *@
@attribute [AllowAnonymous]

<PageTitle>Scores</PageTitle>

<div class="display">
    @* Slow drifting glow behind everything, so a board nobody has scored on yet still
       looks alive from across the room. *@
    <div class="display-ambient"></div>

    @if (Board == null)
    {
        <div class="display-message">
            <span class="display-dots">Connecting<span>.</span><span>.</span><span>.</span></span>
        </div>
    }
    else if (!Board.Success)
    {
        <div class="display-message">@(Board.Error ?? "No scores yet")</div>
    }
    else if (Board.Hidden)
    {
        <div class="display-message">Scores hidden</div>
    }
    else
    {
        <div class="display-header">
            <span class="display-heading">
                @(Board.Mode == GameDisplayMode.CurrentGame
                    ? Board.CurrentGameName ?? $"Game {Board.CurrentGame}"
                    : "Score totals")
            </span>
            @if (Board.Paused)
            {
                <span class="display-paused">Paused</span>
            }
        </div>

        @* Rows shrink as teams are added, so twenty of them still fill the wall. Rows keep
           a stable DOM order and are moved by rank, so a team overtaking another slides
           past it instead of teleporting. *@
        <div class="display-grid" style="@($"--rows: {_rows.Count}; --scale: {RowScale};")">
            @foreach (DisplayRow row in _rows)
            {
                <div class="display-row @(row.IsLeader ? "display-row-leader" : "")"
                     style="@RowStyle(row)"
                     @key="row.Key">
                    <span class="display-team">
                        @if (row.IsLeader)
                        {
                            <span class="display-crown">👑</span>
                        }
                        @row.Label
                    </span>

                    @* The bar sits in a track. Without one, a board of zeros rendered as a
                       row of stubs that read as broken rather than as "nobody has scored". *@
                    <span class="display-bar-track">
                        <span class="display-bar" style="@BarStyle(row)"></span>
                    </span>

                    <span class="display-points">
                        <span class="display-points-value" @key="@($"{row.Key}#{row.Bump}")">
                            @GameScoreFormat.Points(row.Points)
                        </span>
                        @if (row.Delta != 0)
                        {
                            <span class="display-delta @(row.Delta > 0 ? "" : "display-delta-down")"
                                  @key="@($"{row.Key}!{row.Bump}")">
                                @GameScoreFormat.Delta(row.Delta)
                            </span>
                        }
                    </span>
                </div>
            }
        </div>
    }
</div>
