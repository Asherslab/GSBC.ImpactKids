@page "/Display/Scores"
@page "/Display/Scores/{ServiceId:guid}"
@using GSBC.ImpactKids.Shared.Contracts.Entities.Features.Games
@using GSBC.ImpactKids.WASM.Features.Games.Layout
@layout DisplayLayout
@* Overrides the blanket [Authorize] in Features/_Imports.razor. A screen on a wall
   cannot sign in, and this page only ever renders aggregate scores. *@
@attribute [AllowAnonymous]

<PageTitle>Scores</PageTitle>

<div class="display">
    @if (_board == null)
    {
        <div class="display-message">Connecting…</div>
    }
    else if (!_board.Success)
    {
        <div class="display-message">@(_board.Error ?? "No scores yet")</div>
    }
    else if (_board.Hidden)
    {
        <div class="display-message">Scores hidden</div>
    }
    else
    {
        <div class="display-header">
            <span class="display-heading">
                @(_board.Mode == GameDisplayMode.CurrentGame
                    ? _board.CurrentGameName ?? $"Game {_board.CurrentGame}"
                    : "Tonight's Scores")
            </span>
            @if (_board.Paused)
            {
                <span class="display-paused">Paused</span>
            }
        </div>

        @* Rows shrink as teams are added, so twenty of them still fill the wall. *@
        <div class="display-grid"
             style="@($"grid-template-rows: repeat({Rows.Count}, 1fr); --scale: {RowScale};")">
            @foreach (DisplayRow row in Rows)
            {
                @* The bar sits in a track. Without one, a board of zeros rendered as a
                   row of stubs that read as broken rather than as "nobody has scored". *@
                <div class="display-row" style="@($"--team: {row.Colour}; --team-bar: {row.Background};")">
                    <span class="display-team">@row.Label</span>
                    <span class="display-bar-track">
                        <span class="display-bar" style="@BarStyle(row)"></span>
                    </span>
                    <span class="display-points">@row.Points</span>
                </div>
            }
        </div>
    }
</div>
