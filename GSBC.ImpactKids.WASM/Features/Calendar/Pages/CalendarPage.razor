@inherits StoreComponent<CalendarState>
@page "/Calendar"
@inject IRefreshableStore<SchoolTerm>  SchoolTermsStore
@inject IRefreshableStore<Service>     ServicesStore
@inject IRefreshableStore<ServiceType> ServiceTypesStore

<PageTitle>Calendar</PageTitle>

<MudPaper Elevation="6" Class="pt-4 px-3 pb-6 d-flex flex-column" Style="height: 90vh">
    <MudToolBar>
        <MudButtonGroup Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Class="mr-3">
            <MudButton OnClick="@(() => Update(s => s.PreviousMonth()))">@("<")</MudButton>
            <MudButton OnClick="@(() => Update(s => s.NextMonth()))">@(">")</MudButton>
            <MudDatePickerButton
                Date="State.Date"
                OnDateChanged="@(d => Update(s => s.SetDate(d)))"
                OpenTo="@OpenTo.Month"
                Variant="@Variant.Filled"
                FixDay="@(1)"/>
        </MudButtonGroup>
    </MudToolBar>
    <Calendar
        Terms="State.Terms.Data"
        Events="State.Events.Data"
        Date="State.Date"/>
</MudPaper>