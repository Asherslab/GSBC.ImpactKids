@using GSBC.ImpactKids.Shared.Contracts.Entities.Features.ProPresenter
@using GSBC.ImpactKids.Shared.Contracts.Services.Features.ProPresenter
@inherits EntityUtilityComponent
@page "/ProPresenter/Machines"
@inject IRefreshableStore<ProPresenterMachine> MachinesStore
@inject IProPresenterMachineService             MachineService

<PageTitle>ProPresenter</PageTitle>

<MudPaper Elevation="6" Class="mt-4 pa-6">
    <MudText Typo="Typo.h5" Class="mb-2">ProPresenter machines</MudText>

    <MudText Typo="Typo.body2" Class="mb-4">
        A small tool on the ProPresenter Mac connects it to Impact Kids. It starts by itself when
        the Mac logs in, takes its settings from this page, runs a ProPresenter timer from tonight's
        schedule, and serves feeds that ProPresenter can show - what is on now and next, and the names
        of children here for the first time today. It also copies the songs in the libraries chosen
        below to the <MudLink Href="/Songs">Songs</MudLink> page.
    </MudText>

    <MudExpansionPanels Class="mb-4">
        <MudExpansionPanel Text="Set up a new Mac" Expanded="@(_machines.HasData && _machines.Data!.IsEmpty)">
            <ol class="setup-steps">
                <li>
                    On the ProPresenter Mac, download
                    <MudLink Href="@AgentDownloadUrl">the Impact Kids ProPresenter tool</MudLink>
                    and open the zip.
                </li>
                <li>
                    In Terminal, run <code>./install.sh</code> from the unzipped folder. It works on
                    both Intel and Apple Silicon Macs.
                </li>
                <li>
                    A browser opens on this site. Sign in if asked, name the Mac and press
                    <b>Connect this Mac</b>.
                </li>
                <li>Set its ProPresenter address and port below to match ProPresenter's Network preferences.</li>
                <li>
                    Choose the <b>timer that follows the schedule</b> below - one of ProPresenter's own
                    timers. Put that timer on the stage layout; on the night it counts down whatever is on.
                </li>
                <li>
                    On the stage layout, add text boxes linked to these RSS feeds, each with <b>Title</b> only:
                    <ul>
                        <li>what is on now: <code>@ProPresenterFeeds.Url(ProPresenterFeeds.NowPath)</code></li>
                        <li>what is next: <code>@ProPresenterFeeds.Url(ProPresenterFeeds.NextPath)</code></li>
                        <li>
                            one group's own label during a split - add its name:
                            <code>@(ProPresenterFeeds.Url(ProPresenterFeeds.NowPath))?group=4-6</code>
                        </li>
                        <li>first-timers' names: <code>@ProPresenterFeeds.Url(ProPresenterFeeds.FirstTimersPath)</code></li>
                    </ul>
                </li>
            </ol>
            <MudText Typo="Typo.body2" Class="mb-2">
                ProPresenter reads a feed every 10 seconds, so after Next the labels can take that long to
                change. The timer waits for them, so the two change together.
            </MudText>
            <MudText Typo="Typo.body2">
                To update the tool, download it again and rerun <code>./install.sh</code>.
            </MudText>
        </MudExpansionPanel>
    </MudExpansionPanels>

    <div class="relative" style="min-height: 64px">
    <MudOverlay Visible="@(_machines.IsLoading)" DarkBackground Absolute>
        <MudProgressCircular Indeterminate/>
    </MudOverlay>
    @if (_machines.HasData && _machines.Data!.IsEmpty)
    {
        <MudText Typo="Typo.body2">No machines are connected yet.</MudText>
    }
    else if (_machines.HasData)
    {
        <MudTable Items="_machines.Data" Hover Breakpoint="Breakpoint.Sm" Dense>
            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>ProPresenter</MudTh>
                <MudTh>Tool</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Name">
                    @context.Name
                    <MudText Typo="Typo.caption" Class="d-block">
                        Connected @context.LocalCreatedAt.ToString("d MMM yyyy")@(context.CreatedBy == null ? "" : $" by {context.CreatedBy}")
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Status">
                    @{ (string label, Color color) = Status(context); }
                    <MudChip T="string" Size="Size.Small" Color="@color">@label</MudChip>
                    @if (context.LocalLastSeenAt != null)
                    {
                        <MudText Typo="Typo.caption" Class="d-block">
                            Last seen @context.LocalLastSeenAt.Value.ToString("d MMM, h:mm:ss tt")
                        </MudText>
                    }
                </MudTd>
                <MudTd DataLabel="ProPresenter">
                    @context.ProPresenterHost:@context.ProPresenterPort
                    <MudText Typo="Typo.caption" Class="d-block">
                        @(context.ProPresenterReachable switch
                        {
                            true  => context.ProPresenterVersion ?? "Answering",
                            false => "Not answering - is ProPresenter open, with its network enabled?",
                            null  => "Not checked yet"
                        })
                    </MudText>
                    <MudText Typo="Typo.caption" Class="d-block">
                        Schedule timer: @(context.Timers.FirstOrDefault(t => t.Uuid == context.ScheduleTimerUuid)?.Name
                                          ?? (context.ScheduleTimerUuid == null ? "none chosen" : "no longer in ProPresenter"))
                    </MudText>
                    <MudText Typo="Typo.caption" Class="d-block">
                        Songs from: @(context.SongLibraryUuids.IsEmpty
                                      ? "none"
                                      : string.Join(", ", context.SongLibraryUuids.Select(uuid =>
                                          context.Libraries.FirstOrDefault(l => l.Uuid == uuid)?.Name ?? "a library no longer in ProPresenter")))
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Tool">@(context.AgentVersion ?? "-")</MudTd>
                <MudTd>
                    <MudTooltip Text="Edit settings">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small"
                                       aria-label="@($"Edit {context.Name}")"
                                       OnClick="@(() => StartEdit(context))"/>
                    </MudTooltip>
                    <MudTooltip Text="Disconnect">
                        <MudIconButton Icon="@Icons.Material.Filled.LinkOff"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       aria-label="@($"Disconnect {context.Name}")"
                                       OnClick="@(() => Revoke(context))"/>
                    </MudTooltip>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
    else if (_machines.HasError)
    {
        <MudAlert Severity="Severity.Error">@_machines.Error</MudAlert>
    }
    </div>
</MudPaper>

@if (_editing != null)
{
    <MudPaper Elevation="6" Class="mt-4 pa-6">
        <MudText Typo="Typo.h6" Class="mb-2">Edit @_editingName</MudText>
        <MudText Typo="Typo.body2" Class="mb-4">
            The Mac picks changes up within half a minute. The address is where the tool finds
            ProPresenter - usually 127.0.0.1, ProPresenter on the same Mac - and the port is the one
            in ProPresenter's Network preferences.
        </MudText>
        <MudTextField T="string" @bind-Value="_editing.Name" Label="Name" MaxLength="100" Class="mb-2"/>
        <MudTextField T="string" @bind-Value="_editing.ProPresenterHost" Label="ProPresenter address" MaxLength="255" Class="mb-2"/>
        <MudNumericField T="int" @bind-Value="_editing.ProPresenterPort" Label="ProPresenter port" Min="1" Max="65535" Class="mb-2"/>
        @* The timers come from ProPresenter itself, as the Mac last reported them. *@
        <MudSelect T="string"
                   @bind-Value="_editing.ScheduleTimerUuid"
                   Label="Timer that follows the schedule"
                   HelperText="@(_editingTimers.Count == 0 ? "No timers reported yet - is ProPresenter open on the Mac?" : "The one ProPresenter timer tonight's schedule counts down on")"
                   Clearable="true"
                   Class="mb-4">
            @foreach (ProPresenterTimer timer in _editingTimers)
            {
                <MudSelectItem T="string" Value="@timer.Uuid">@timer.Name</MudSelectItem>
            }
        </MudSelect>
        @* The libraries come from ProPresenter too. Their songs appear on the Songs page. *@
        <MudSelect T="string"
                   MultiSelection="true"
                   SelectedValues="_editing.SongLibraryUuids"
                   SelectedValuesChanged="@(values => _editing.SongLibraryUuids = values.ToList())"
                   ToStringFunc="@LibraryName"
                   Label="Libraries to copy songs from"
                   HelperText="@(_editingLibraries.Count == 0 ? "No libraries reported yet - is ProPresenter open on the Mac?" : "Their songs appear on the Songs page, for song leaders to read")"
                   Class="mb-4">
            @foreach (ProPresenterLibrary library in _editingLibraries)
            {
                <MudSelectItem T="string" Value="@library.Uuid">@library.Name</MudSelectItem>
            }
        </MudSelect>
        <MudStack Row Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_busy" OnClick="@SaveEdit">Save</MudButton>
            <MudButton Variant="Variant.Text" Disabled="@_busy" OnClick="@(() => _editing = null)">Cancel</MudButton>
        </MudStack>
    </MudPaper>
}
