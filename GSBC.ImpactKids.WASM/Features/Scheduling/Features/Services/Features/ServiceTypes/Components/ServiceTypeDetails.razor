@inherits DetailsComponent<ServiceType, CreateServiceTypeRequest, UpdateServiceTypeRequest>

<MudPaper Elevation="0" Class="d-flex flex-column flex-grow-1">
    <MudOverlay Visible="@(Entity.IsLoading)"
                DarkBackground="true"
                Absolute="true">
        <MudProgressCircular Indeterminate/>
    </MudOverlay>
    @if (Entity.HasError)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">
            @(Entity.Error ?? "An Unexpected error occured")
        </MudAlert>
    }
    <MudTextFieldCreateOrUpdate
        @bind-Create="@CreateRequest.Label"
        Read="@UpdateRequest.Label.Value"
        @bind-Update="@UpdateRequest.Label.Value"
        State="State"

        Class="mb-4"
        Label="Label"
        Variant="Variant.Filled"
        Immediate/>
    <MudColorPickerCreateOrUpdate
        @bind-Create="@CreateRequest.Color"
        Read="@UpdateRequest.Color.Value"
        @bind-Update="@UpdateRequest.Color.Value"
        State="State"

        Class="mb-4"
        Label="Colour"
        Variant="Variant.Filled"
        ColorPickerMode="ColorPickerMode.HEX"
        ShowAlpha="false"
    
        Style="@($"color: {UpdateRequest.Color.Value ?? CreateRequest.Color}")"
        ShowToolbar/>
</MudPaper>