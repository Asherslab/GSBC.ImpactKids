@inherits StoreComponentWithUtilities<MultipleServiceTypesState>
@page "/Services/ServiceTypes"
@inject IRefreshableStore<ServiceType> ServiceTypesStore
@inject IServiceTypeService            ServiceTypesService

<PageTitle>Service Types</PageTitle>

<MudPaper Elevation="6" Class="mt-4 relative">
    <MudOverlay Visible="@(State.FilteredServiceTypes.IsLoading)"
                DarkBackground
                Absolute>
        <MudProgressCircular Indeterminate/>
    </MudOverlay>
    <MudTextField
        T="string"
        Value="State.Search"
        ValueChanged="@(OnSearch)"
        Placeholder="Search"
        Adornment="Adornment.Start"
        AdornmentIcon="@Icons.Material.Filled.Search"
        IconSize="Size.Medium"
        Clearable="true"
        Class="py-6 px-6"
        Immediate/>
    <MudTable
        Items="State.FilteredServiceTypes.Data"
        Hover="true" Breakpoint="Breakpoint.None">
        <HeaderContent>
            <MudTh>
                <MudIconButton OnClick="@(() => _showCreateDialog = true)"
                               Icon="@Icons.Material.Filled.PostAdd"/>
            </MudTh>
            <MudTh>Label</MudTh>
            <MudTh>Color</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                <MudButtonGroup Variant="Variant.Outlined">
                    <MudIconButton OnClick="@(() => ShowUpdateServiceType(context))"
                                   Icon="@Icons.Material.Filled.Edit"/>
                    <MudIconButton OnClick="@(() => ShowDeleteServiceType(context))"
                                   Icon="@Icons.Material.Filled.Delete"/>
                </MudButtonGroup>
            </MudTd>
            <MudTd DataLabel="Label">@context.Label</MudTd>
            <MudTd DataLabel="Color">
                <MudText Style="@($"color: {context.Color}")">@context.Color</MudText>
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>

<MudDialog @bind-Visible="_showCreateDialog">
    <TitleContent>Create Service Type</TitleContent>
    <DialogContent>
        <ServiceTypeDetails
            @ref="_serviceTypeDetails"
            State="ModificationState.Creating"/>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showCreateDialog = false)">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="@CreateServiceType">Submit</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_showUpdateDialog">
    <TitleContent>Update Service Type</TitleContent>
    <DialogContent>
        <ServiceTypeDetails
            @ref="_serviceTypeDetails"
            ServiceType="_updatingServiceType"
            State="ModificationState.Updating"/>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showUpdateDialog = false)">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="@UpdateServiceType">Submit</MudButton>
    </DialogActions>
</MudDialog>