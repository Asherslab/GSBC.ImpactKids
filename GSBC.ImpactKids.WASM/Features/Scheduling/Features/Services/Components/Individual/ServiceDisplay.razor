@inherits DisplayComponent<Service>
@inject IBasicDeleteService<Service>   DeleteService
@inject IRefreshableStore<ServiceType> ServiceTypesStore

<MudPaper Elevation="6" Class="relative">
    <MudOverlay Visible="@(Entity.IsLoading || _serviceType.IsLoading)" DarkBackground="true" Absolute="true">
        <MudProgressCircular Indeterminate/>
    </MudOverlay>
    <MudLink Underline="Underline.None" Href="@Href">
        <MudPaper Elevation="0" Class="@Class">
            <MudPaper Elevation="0" Class="d-flex justify-center flex-column flex-grow-1 ma-3">
                @if (Entity.Data == null || (_serviceType.Data == null && Entity.Data.Name == null))
                {
                    <MudText Typo="Typo.body1">
                        Service
                    </MudText>
                }
                @if (Entity.Data?.Name != null)
                {
                    <MudText Typo="Typo.body1">
                        @Entity.Data!.Name
                    </MudText>
                }
                @if (_serviceType.Data != null)
                {
                    Typo typo = Typo.body1;
                    @if (Entity.Data?.Name != null)
                        typo = Typo.body2;

                    <MudText Typo="typo" Style="@($"color: {_serviceType.Data.Color}")">
                        @_serviceType.Data.Label
                    </MudText>
                }
            </MudPaper>
            <MudPaper Elevation="0" Class="d-flex justify-center flex-column flex-grow-0 mr-5">
                @if (!Entity.HasData)
                {
                    <MudText Typo="Typo.caption">
                        Date
                    </MudText>
                }
                else
                {
                    <MudText Typo="Typo.caption">
                        @Entity.Data!.LocalDate.ToString("ddd dd/MM")
                    </MudText>
                }
            </MudPaper>
            @if (AllowDeleting)
            {
                <MudPaper Elevation="0" Class="d-flex justify-end">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   OnClick="@DeleteClicked"/>
                </MudPaper>
            }
        </MudPaper>
    </MudLink>
</MudPaper>