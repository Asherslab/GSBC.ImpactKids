@inject IRefreshableStore<Service>     ServicesStore
@inject IRefreshableStore<ServiceType> ServiceTypesStore

<MudLink Underline="Underline.None"
         Href="@(_service.HasData ? $"/Services/{_service.Data!.Id}" : null)">
    <MudPaper Elevation="6"
              Class="clickable mud-ripple d-flex justify-start flex-direction-row flex-grow-1">
        <MudPaper Elevation="0" Class="d-flex justify-center flex-column flex-grow-1 ma-3">
            @if (_service.Data == null || (_serviceType.Data == null && _service.Data.Name == null))
            {
                <MudText Typo="Typo.body1">
                    Service
                </MudText>
            }
            @if (_service.Data?.Name != null)
            {
                <MudText Typo="Typo.body1">
                    @_service.Data!.Name
                </MudText>
            }
            @if (_serviceType.Data != null)
            {
                Typo typo = Typo.body1;
                @if (_service.Data?.Name != null)
                    typo = Typo.body2;

                <MudText Typo="typo" Style="@($"color: {_serviceType.Data.Color}")">
                    @_serviceType.Data.Label
                </MudText>
            }
        </MudPaper>
        <MudPaper Elevation="0" Class="d-flex justify-center flex-column flex-grow-0 mr-5">
            @if (!_service.HasData)
            {
                <MudText Typo="Typo.caption">
                    Date
                </MudText>
            }
            else
            {
                <MudText Typo="Typo.caption">
                    @_service.Data!.LocalDate.ToString("ddd dd/MM")
                </MudText>
            }
        </MudPaper>
    </MudPaper>
</MudLink>