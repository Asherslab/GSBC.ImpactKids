@inject IRefreshableStore<DollarStoreEntry> DollarStoreEntriesStore

<MudGrid Spacing="6" Justify="Justify.Center">
    <MudItem xs="12" md="4">
        <MudGrid Spacing="6" Justify="Justify.Center">
            <MudItem xs="12">
                <DetailsModificationCard
                    Id="Id"
                    DetailsComponentType="@(typeof(ServiceDetails))"/>
            </MudItem>
        </MudGrid>
    </MudItem>
    <MudItem xs="12" md="8">
        <MudGrid Spacing="6" Justify="Justify.FlexStart">
            <MudItem xs="12" md="6">
                <MudCard Elevation="6" Class="relative">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudPaper Elevation="0" Class="d-flex justify-space-between flex-grow-1">
                                <MudText Typo="Typo.h6" Align="Align.Start">Memory Verses</MudText>
                            </MudPaper>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <ListComponent T="MemoryVerse"
                                       Filter="@(x => x.ServiceIds.Contains(Id ?? Guid.Empty))"
                                       Spacing="3"
                                       Context="memoryVerseId">
                            <MudItem xs="12">
                                <MemoryVerseDisplay Id="memoryVerseId"
                                                    Href="@(Id == null ? null : $"/Scripture/Memorisation/Tool/{Id}?{nameof(Tool.MemoryVerseId)}={memoryVerseId}")"/>
                            </MudItem>
                        </ListComponent>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="6" Class="relative">
                <DetailsModificationCard
                    ShowCreate="@(_dollarStoreEntry.Data == null)"
                    ExtraParameters="@(new Dictionary<string, object?> { { nameof(DollarStoreEntryDetails.ServiceId), Id } })"
                    DetailsComponentType="@(typeof(DollarStoreEntryDetails))"/>
            </MudItem>
            @*<MudItem xs="12" md="6">
                <MudCard Elevation="6" Class="relative">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6" Align="Align.Start">Roster</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                    </MudCardContent>
                </MudCard>
            </MudItem>*@
        </MudGrid>
    </MudItem>
</MudGrid>