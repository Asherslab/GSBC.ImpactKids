@inject IRefreshableStore<Service>          ServicesStore
@inject IRefreshableStore<DollarStoreEntry> DollarStoreEntriesStore

<MudGrid Spacing="6" Justify="Justify.Center">
    <MudItem xs="12" md="4">
        <MudGrid Spacing="6" Justify="Justify.Center">
            <MudItem xs="12">
                <MudCard Elevation="6" Class="relative">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudPaper Elevation="0" Class="d-flex justify-space-between flex-grow-1">
                                <MudText Typo="Typo.h6" Align="Align.Start">Details</MudText>
                                <MudPaper Elevation="0" Class="d-flex justify-end flex-grow-0">
                                    <ModificationStateSwitcher
                                        @bind-State="_detailsState"
                                        OnUpdate="UpdateService"
                                        OnDelete="DeleteService"/>
                                </MudPaper>
                            </MudPaper>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <ServiceDetails
                            @ref="_serviceDetailsComponent"
                            Id="@ServiceId"
                            State="_detailsState"/>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    </MudItem>
    <MudItem xs="12" md="8">
        <MudGrid Spacing="6" Justify="Justify.FlexStart">
            <MudItem xs="12" md="6">
                <MudCard Elevation="6" Class="relative">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudPaper Elevation="0" Class="d-flex justify-space-between flex-grow-1">
                                <MudText Typo="Typo.h6" Align="Align.Start">Memory Verses</MudText>
                            </MudPaper>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MemoryVerseList
                            ServiceId="@ServiceId"/>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudCard Elevation="6" Class="relative">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudPaper Elevation="0" Class="d-flex justify-space-between flex-grow-1">
                                <MudText Typo="Typo.h6" Align="Align.Start">Dollar Store</MudText>
                                <MudPaper Elevation="0" Class="d-flex justify-end flex-grow-0">
                                    <ModificationStateSwitcher
                                        @bind-State="_dollarStoreState"
                                        ShowCreate="@(_dollarStoreEntry.Data == null)"
                                        OnCreate="CreateDollarStoreEntry"
                                        OnUpdate="UpdateDollarStoreEntry"
                                        OnDelete="DeleteDollarStoreEntry"/>
                                </MudPaper>
                            </MudPaper>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <DollarStoreEntryDetails
                            @ref="_dollarStoreDetailsComponent"
                            ServiceId="ServiceId"
                            State="_dollarStoreState"/>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            @*<MudItem xs="12" md="6">
                <MudCard Elevation="6" Class="relative">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6" Align="Align.Start">Roster</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                    </MudCardContent>
                </MudCard>
            </MudItem>*@
        </MudGrid>
    </MudItem>
</MudGrid>