@inject IRefreshableStore<Service>     ServicesStore
@inject IRefreshableStore<ServiceType> ServiceTypesStore
@inject IRefreshableStore<SchoolTerm>  SchoolTermsStore
@inject IServicesService               ServicesService

<MudPaper Elevation="0" Class="d-flex flex-column flex-grow-1">
    <MudOverlay Visible="@(_service.IsLoading)"
                DarkBackground="true"
                Absolute="true">
        <MudProgressCircular Indeterminate/>
    </MudOverlay>
    @if (_service.HasError)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">
            @(_service.Error ?? "An Unexpected error occured")
        </MudAlert>
    }
    <MudTextFieldCreateOrUpdate
        @bind-Create="@_createRequest.Name"
        Read="@_updateRequest.Name.Value"
        @bind-Update="@_updateRequest.Name.Value"
        State="State"

        Class="mb-4"
        Label="Name"
        Variant="Variant.Filled"
        Immediate/>
    <MudRequiredDatePickerCreateOrUpdate
        @bind-Create="@_createRequest.LocalDate"
        Read="@_updateRequest.LocalDate.Value"
        @bind-Update="@_updateRequest.LocalDate.Value"
        State="State"

        Class="mb-4"
        Label="Date"
        Variant="Variant.Filled"

        Editable/>

    <div class="relative mb-4">
        <MudOverlay Visible="@(SchoolTermsStore.GetState().Entities.IsLoading)"
                    DarkBackground
                    Absolute>
            <MudProgressCircular Indeterminate/>
        </MudOverlay>
        <MudSelectCreateOrUpdate
            @bind-Create="@_createRequest.SchoolTermId"
            Read="@_updateRequest.SchoolTermId.Value"
            @bind-Update="@_updateRequest.SchoolTermId.Value"
            State="State"

            Label="School Term"
            Variant="Variant.Filled"

            Clearable>
            @foreach (SchoolTerm schoolTerm in GetSchoolTermsForDropdown())
            {
                <MudSelectItem T="Guid?"
                               Value="@schoolTerm.Id">
                    @(schoolTerm.Name)
                </MudSelectItem>
            }
        </MudSelectCreateOrUpdate>
    </div>

    <div class="relative mb-4">
        <MudOverlay Visible="@(ServiceTypesStore.GetState().Entities.IsLoading)"
                    DarkBackground
                    Absolute>
            <MudProgressCircular Indeterminate/>
        </MudOverlay>
        <MudSelectCreateOrUpdate
            @bind-Create="@_createRequest.ServiceTypeId"
            Read="@_updateRequest.ServiceTypeId.Value"
            @bind-Update="@_updateRequest.ServiceTypeId.Value"
            State="State"

            Label="Service Type"
            Variant="Variant.Filled"

            Clearable>
            @if (ServiceTypesStore.GetState().Entities.HasData)
            {
                foreach (ServiceType serviceType in ServiceTypesStore.GetState().Entities.Data!)
                {
                    <MudSelectItem T="Guid?"
                                   Value="@serviceType.Id"
                                   Style="@($"color: {serviceType.Color ?? ServiceType.ColorBackup}")">
                        @serviceType.Label
                    </MudSelectItem>
                }
            }
        </MudSelectCreateOrUpdate>
    </div>
</MudPaper>