@inject IRefreshableStore<Service> ServicesStore

<MudOverlay Visible="@(_serviceIds.IsNotAsked || _serviceIds.IsLoading)" DarkBackground="true" Absolute="true">
    <MudProgressCircular Indeterminate/>
</MudOverlay>
@if (_serviceIds.Data != null && !ShowFakes)
{
    <MudStack>
        @foreach (Guid id in _serviceIds.Data)
        {
            <ServiceDisplay Id="id"/>
        }
    </MudStack>
}
else
{
    <MudStack>
        @foreach (int _ in Enumerable.Range(0, 5))
        {
            <ServiceDisplay/>
        }
    </MudStack>
}