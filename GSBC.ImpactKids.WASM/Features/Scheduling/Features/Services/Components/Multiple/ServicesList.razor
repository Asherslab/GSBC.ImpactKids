<MudOverlay Visible="@_waitingForUpdate" DarkBackground="true" Absolute="true">
    <MudProgressCircular Indeterminate/>
</MudOverlay>
@if (_services != null)
{
    <MudStack>
        @foreach (Service service in _services)
        {
            <ServiceDisplay Service="service"/>
        }
    </MudStack>
}
else
{
    <MudStack>
        @foreach (int _ in Enumerable.Range(0, 5))
        {
            <ServiceDisplay/>
        }
    </MudStack>
}