@inherits EventListeningComponent
@page "/Services"
@inject ISchoolTermsService SchoolTermsService
@inject IServiceTypeService ServiceTypeService
@inject IServicesService    ServicesService
@inject NavigationManager   Navigation

<PageTitle>Services</PageTitle>

<MudPaper Elevation="6" Class="mt-4 px-6 pb-6">
    <MudGrid>
        <MudItem xs="4" md="3">
            <MudGrid Spacing="1">
                <MudItem xs="12" md="6">
                    <MudDatePicker OpenTo="OpenTo.Year"
                                   Date="_date"
                                   DateChanged="OnDateChanged"
                                   FixMonth="1"
                                   FixDay="1"
                                   Class="pt-2"
                                   DateFormat="yyyy"/>
                </MudItem>
                <MudItem xs="12" md="6">
                    <div class="relative">
                        <MudOverlay Visible="@(_serviceTypes == null)"
                                    DarkBackground
                                    Absolute>
                            <MudProgressCircular Indeterminate/>
                        </MudOverlay>
                        <MudSelect T="Guid?"
                                   Value="ServiceType"
                                   ValueChanged="ServiceTypeChanged"
                                   Placeholder="Service Type"
                                   Class="pt-2"
                                   Clearable>
                            @if (_serviceTypes != null)
                            {
                                foreach (ServiceType serviceType in _serviceTypes)
                                {
                                    <MudSelectItem T="Guid?"
                                                   Value="@serviceType.Id"
                                                   Style="@($"color: {serviceType.Color ?? Shared.Contracts.Entities.Features.Scheduling.ServiceType.ColorBackup}")">
                                        @serviceType.Label
                                    </MudSelectItem>
                                }
                            }
                        </MudSelect>
                    </div>
                </MudItem>
            </MudGrid>
        </MudItem>
        <MudItem xs="4" md="6">
            <MudText Align="Align.Center"
                     Typo="Typo.h5"
                     Class="flex-grow-1 py-3">
                Services
            </MudText>
        </MudItem>
        <MudItem xs="4" md="3">
            <MudGrid Spacing="1">
                <MudItem xs="12" md="2">
                    <MudIconButton OnClick="@(() => _showCreateDialog = true)"
                                   Icon="@Icons.Material.Filled.PostAdd"/>
                </MudItem>
                <MudItem xs="12" md="10">
                    <MudSelect T="ServiceDisplayOptions"
                               Value="_display"
                               ValueChanged="DisplayChanged"
                               Class="pt-2">
                        <MudSelectItem Value="ServiceDisplayOptions.Quarters">
                            Quarters
                        </MudSelectItem>
                        <MudSelectItem Value="ServiceDisplayOptions.SchoolTerms">
                            School Terms
                        </MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>
        </MudItem>
    </MudGrid>
    <MudGrid>
        @if (_display == ServiceDisplayOptions.Quarters)
        {
            foreach ((int quarter, ICollection<Service>? services) in _quarters)
            {
                <MudItem xs="12" md="3">
                    <MudCard Elevation="6" Class="relative">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6" Align="Align.Start">@($"Q{quarter} {_date?.Year}")</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <ServicesList Services="services"/>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        }
        else if (_schoolTerms == null)
        {
            foreach (int term in Enumerable.Range(1, 4))
            {
                <MudItem xs="12" md="3">
                    <MudCard Elevation="6" Class="relative">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6" Align="Align.Start">@($"Term {term} {_date?.Year}")</MudText>
                                <MudText Typo="Typo.body2">
                                    dd/MM -> dd/MM
                                </MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <ServicesList/>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        }
        else
        {
            foreach (SchoolTerm term in _schoolTerms)
            {
                <MudItem xs="12" md="3">
                    <MudCard Elevation="6" Class="relative">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6" Align="Align.Start">@term.Name</MudText>
                                <MudText Typo="Typo.body2">
                                    @term.LocalStartDate.ToString("dd/MM") -> @term.LocalEndDate.ToString("dd/MM")
                                </MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <ServicesList Services="GetServicesForTerm(term)"/>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        }
    </MudGrid>
</MudPaper>

<MudDialog @bind-Visible="_showCreateDialog">
    <TitleContent>Create Service</TitleContent>
    <DialogContent>
        <ServiceDetails
            @ref="_serviceDetails"
            State="ModificationState.Creating"/>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showCreateDialog = false)">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="@CreateService">Submit</MudButton>
    </DialogActions>
</MudDialog>
