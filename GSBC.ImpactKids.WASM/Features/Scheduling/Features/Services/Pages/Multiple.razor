@inherits StoreComponentWithUtilities<MultipleServicesState>
@page "/Services"
@inject IRefreshableStore<SchoolTerm>  SchoolTermsStore
@inject IRefreshableStore<ServiceType> ServiceTypesStore

<PageTitle>Services</PageTitle>

<MudPaper Elevation="6" Class="mt-4 pt-1 px-6 pb-6">
    <MudGrid>
        <MudItem xs="4" md="3">
            <MudGrid Spacing="1">
                <MudItem xs="12" md="6">
                    <MudDatePicker OpenTo="OpenTo.Year"
                                   Date="@State.Date"
                                   DateChanged="OnDateChanged"
                                   FixMonth="1"
                                   FixDay="1"
                                   Class="pt-2"
                                   DateFormat="yyyy"/>
                </MudItem>
                <MudItem xs="12" md="6">
                    <div class="relative">
                        <MudOverlay Visible="@(ServiceTypesStore.GetState().Entities.IsLoading)"
                                    DarkBackground
                                    Absolute>
                            <MudProgressCircular Indeterminate/>
                        </MudOverlay>
                        <MudSelect T="Guid?"
                                   Value="@State.ServiceType"
                                   ValueChanged="ServiceTypeChanged"
                                   Placeholder="Service Type"
                                   Class="pt-2"
                                   Clearable>
                            @if (ServiceTypesStore.GetState().Entities.HasData)
                            {
                                foreach (ServiceType serviceType in ServiceTypesStore.GetState().Entities.Data!)
                                {
                                    <MudSelectItem T="Guid?"
                                                   Value="@serviceType.Id"
                                                   Style="@($"color: {serviceType.Color ?? ServiceType.ColorBackup}")">
                                        @serviceType.Label
                                    </MudSelectItem>
                                }
                            }
                        </MudSelect>
                    </div>
                </MudItem>
            </MudGrid>
        </MudItem>
        <MudItem xs="4" md="6">
            <MudText Align="Align.Center"
                     Typo="Typo.h5"
                     Class="flex-grow-1 py-3">
                Services
            </MudText>
        </MudItem>
        <MudItem xs="4" md="3">
            <MudGrid Spacing="1">
                <MudItem xs="12" md="4" Class="d-flex justify-end">
                    @if (State.Display == ServiceDisplayOptions.SchoolTerms)
                    {
                        <MudIconButton OnClick="@CreateSchoolTerm"
                                       Icon="@Icons.Material.Filled.DomainAdd"/>
                    }
                    <MudIconButton OnClick="@CreateService"
                                   Icon="@Icons.Material.Filled.PostAdd"/>
                </MudItem>
                <MudItem xs="12" md="8">
                    <MudSelect T="ServiceDisplayOptions"
                               Value="@State.Display"
                               ValueChanged="DisplayChanged"
                               Class="pt-2">
                        <MudSelectItem Value="ServiceDisplayOptions.Quarters">
                            Quarters
                        </MudSelectItem>
                        <MudSelectItem Value="ServiceDisplayOptions.SchoolTerms">
                            School Terms
                        </MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>
        </MudItem>
    </MudGrid>
    <MudGrid>
        @if (State.Display == ServiceDisplayOptions.Quarters)
        {
            foreach (int quarter in Enumerable.Range(1, 4))
            {
                <MudItem xs="12" md="3">
                    <MudCard Elevation="6" Class="relative">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6"
                                         Align="Align.Start">@($"Q{quarter} {State.Date?.Year}")</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <ListComponent T="Service"
                                           Filter="@(ServiceFilterForQuarters(quarter))"
                                           Ordering="@(l => l.OrderBy(x => x.LocalDate))"
                                           Spacing="3"
                                           Context="quarterServiceId">
                                <MudItem xs="12">
                                    <ServiceDisplay Id="quarterServiceId" Link/>
                                </MudItem>
                            </ListComponent>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        }
        else if (State.FilteredSchoolTerms.Data == null)
        {
            foreach (int term in Enumerable.Range(1, 4))
            {
                <MudItem xs="12" md="3">
                    <MudCard Elevation="6" Class="relative">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudOverlay Visible="State.FilteredSchoolTerms.IsLoading" DarkBackground="true"
                                            Absolute="true">
                                    <MudProgressCircular Indeterminate/>
                                </MudOverlay>
                                <MudText Typo="Typo.h6"
                                         Align="Align.Start">@($"Term {term} {State.Date?.Year}")</MudText>
                                <MudText Typo="Typo.body2">
                                    dd/MM -> dd/MM
                                </MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <ListComponent T="Service" FakeEntries="5">
                                <MudItem xs="12">
                                    <ServiceDisplay/>
                                </MudItem>
                            </ListComponent>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        }
        else
        {
            foreach (SchoolTerm term in State.FilteredSchoolTerms.Data)
            {
                <MudItem xs="12" md="3">
                    <MudCard Elevation="6" Class="relative">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudStack Row>
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.h6" Align="Align.Start">@term.Name</MudText>
                                        <MudText Typo="Typo.body2">
                                            @term.LocalStartDate.ToString("dd/MM") -> @term.LocalEndDate.ToString("dd/MM")
                                        </MudText>
                                    </MudStack>
                                    <MudSpacer/>
                                    <MudButton Variant="Variant.Text" Href="@($"/SchoolTerms/{term.Id}")">View
                                    </MudButton>
                                </MudStack>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <ListComponent T="Service"
                                           Filter="@(ServiceFilterForSchoolTerm(term.Id))"
                                           Ordering="@(l => l.OrderBy(x => x.LocalDate))"
                                           Spacing="3"
                                           Context="schoolTermServiceId">
                                <MudItem xs="12">
                                    <ServiceDisplay Id="schoolTermServiceId" Link/>
                                </MudItem>
                            </ListComponent>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        }
    </MudGrid>
</MudPaper>