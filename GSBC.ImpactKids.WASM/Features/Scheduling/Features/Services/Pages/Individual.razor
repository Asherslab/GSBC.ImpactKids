@using GSBC.ImpactKids.Shared.Contracts.Services.Features.Scripture.Memorisation
@inherits EventListeningComponent
@page "/Services/{Id:guid}"
@inject IServicesService         ServicesService
@inject IMemoryVersesService     MemoryVersesService
@inject IDollarStoreEntryService DollarStoreEntryService
@inject NavigationManager        Navigation

<PageTitle>Service Name</PageTitle>

<MudPaper Elevation="6" Class="mt-4 px-6 pb-6">
    @if (_service != null)
    {
        <MudText Align="Align.Center" Typo="Typo.h5" Class="py-3">@_service.GetDisplayName()</MudText>
    }
    else
    {
        <MudText Align="Align.Center" Typo="Typo.h5" Class="py-3">Service</MudText>
    }
    <ServiceOverview
        Service="_service"
        MemoryVerses="_memoryVerses"
        DeleteService="DeleteService"
        DeleteDollarStore="DeleteDollarStoreEntry"/>
</MudPaper>