@inject IRefreshableStore<SchoolTerm> SchoolTermsStore

<MudGrid Spacing="6" Justify="Justify.Center">
    <MudItem xs="4">
        <DetailsModificationCard
            Id="Id"
            DetailsComponentType="@(typeof(SchoolTermDetails))"/>
    </MudItem>
    <MudItem xs="4">
        <MudCard Elevation="6" Class="relative">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudPaper Elevation="0" Class="d-flex justify-space-between flex-grow-1">
                        <MudText Typo="Typo.h6" Align="Align.Start">Services</MudText>
                    </MudPaper>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <ListComponent T="Service"
                               Filter="@(x => x.SchoolTermId == Id)"
                               Ordering="@(l => l.OrderBy(x => x.LocalDate))"
                               Spacing="3"
                               Context="schoolTermServiceId">
                    <MudItem xs="12">
                        <ServiceDisplay Id="schoolTermServiceId"/>
                    </MudItem>
                </ListComponent>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>