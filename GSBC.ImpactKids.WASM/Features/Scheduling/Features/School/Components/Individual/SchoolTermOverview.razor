@using GSBC.ImpactKids.WASM.Features.Scheduling.Features.Services.Components.Multiple
@inject IRefreshableStore<SchoolTerm> SchoolTermsStore

<MudGrid Spacing="6" Justify="Justify.Center">
    <MudItem xs="4">
        <MudCard Elevation="6" Class="relative">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudPaper Elevation="0" Class="d-flex justify-space-between flex-grow-1">
                        <MudText Typo="Typo.h6" Align="Align.Start">Details</MudText>
                        <MudPaper Elevation="0" Class="d-flex justify-end flex-grow-0">
                            <ModificationStateSwitcher
                                @bind-State="_detailsState"
                                OnUpdate="UpdateService"
                                OnDelete="DeleteService"/>
                        </MudPaper>
                    </MudPaper>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <SchoolTermDetails
                    @ref="_schoolTermDetailsComponent"
                    Id="@SchoolTermId"
                    State="_detailsState"/>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="4">
        <MudCard Elevation="6" Class="relative">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudPaper Elevation="0" Class="d-flex justify-space-between flex-grow-1">
                        <MudText Typo="Typo.h6" Align="Align.Start">Services</MudText>
                    </MudPaper>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <ServicesList
                    SchoolTermId="SchoolTermId"/>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>