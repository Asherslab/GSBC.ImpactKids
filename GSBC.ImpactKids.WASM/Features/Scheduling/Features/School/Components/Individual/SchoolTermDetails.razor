@inject IRefreshableStore<SchoolTerm> SchoolTermsStore
@inject ISchoolTermsService           SchoolTermsService

<MudPaper Elevation="0" Class="d-flex flex-column flex-grow-1">
    <MudOverlay Visible="@(_schoolTerm.IsLoading)"
                DarkBackground="true"
                Absolute="true">
        <MudProgressCircular Indeterminate/>
    </MudOverlay>
    @if (_schoolTerm.HasError)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">
            @(_schoolTerm.Error ?? "An Unexpected error occured")
        </MudAlert>
    }
    <MudTextFieldCreateOrUpdate
        @bind-Create="@_createRequest.Name"
        Read="@_updateRequest.Name.Value"
        @bind-Update="@_updateRequest.Name.Value"
        State="State"

        Class="mb-4"
        Label="Name"
        Variant="Variant.Filled"
        Immediate/>
    <MudRequiredDatePickerCreateOrUpdate
        @bind-Create="@_createRequest.LocalStartDate"
        Read="@_updateRequest.LocalStartDate.Value"
        @bind-Update="@_updateRequest.LocalStartDate.Value"
        State="State"

        Class="mb-4"
        Label="Start Date"
        Variant="Variant.Filled"

        Editable/>
    <MudRequiredDatePickerCreateOrUpdate
        @bind-Create="@_createRequest.LocalEndDate"
        Read="@_updateRequest.LocalEndDate.Value"
        @bind-Update="@_updateRequest.LocalEndDate.Value"
        State="State"

        Class="mb-4"
        Label="End Date"
        Variant="Variant.Filled"

        Editable/>
</MudPaper>