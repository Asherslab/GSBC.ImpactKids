@using GSBC.ImpactKids.Shared.Contracts.Entities.Features.Songs
@using GSBC.ImpactKids.WASM.Features.Songs.Pages
@inject IScheduleService        ScheduleService
@inject IRefreshableStore<Song> SongsStore

<MudDialog>
    <DialogContent>
        <MudTextField T="string"
                      @bind-Value="_name"
                      Label="Name"
                      Variant="Variant.Filled"
                      Immediate="true"
                      Class="mb-4"/>
        @if (Item?.IsSong == true)
        {
            <MudAutocomplete T="string"
                             Value="@_fillIn"
                             ValueChanged="@SetSong"
                             SearchFunc="@SearchSongs"
                             CoerceValue="true"
                             Clearable="true"
                             Label="Song"
                             Placeholder="Search the song library, or type a new song's name"
                             HelperText="@SongHelp"
                             Variant="Variant.Filled"
                             AutoFocus="@string.IsNullOrEmpty(Item.FillIn)"
                             Class="mb-4"/>
            @if (LinkedSong is { } song)
            {
                @if (!song.Arrangements.IsEmpty)
                {
                    <MudText Typo="Typo.caption" Style="opacity: 0.7">Arrangement — leave unpicked for the song's usual one</MudText>
                    <MudChipSet T="string"
                                SelectionMode="SelectionMode.ToggleSelection"
                                @bind-SelectedValue="_arrangementUuid"
                                CheckMark
                                Variant="Variant.Outlined"
                                Class="mb-2">
                        @foreach (SongArrangement arrangement in song.Arrangements)
                        {
                            <MudChip T="string" Value="arrangement.Uuid" Text="@arrangement.Name"/>
                        }
                    </MudChipSet>
                }
                <MudButton Href="@SongLyrics.Link(song.Id, _arrangementUuid)"
                           StartIcon="@Icons.Material.Filled.LibraryMusic"
                           Variant="Variant.Text"
                           Size="Size.Small"
                           Class="mb-4">
                    Words
                </MudButton>
            }
        }
        else if (Item?.NeedsFillIn == true || !string.IsNullOrEmpty(_fillIn))
        {
            <MudTextField T="string"
                          @bind-Value="_fillIn"
                          Label="@($"Fill in for {(_name ?? "this item")}")"
                          Placeholder="e.g. the song's name"
                          Variant="Variant.Filled"
                          Immediate="true"
                          AutoFocus="@(Item?.NeedsFillIn == true && string.IsNullOrEmpty(Item.FillIn))"
                          Class="mb-4"/>
        }
        @* Under a section an item has no time of its own; the section holds it. *@
        @if (!UnderSection)
        {
            <MudNumericField T="int"
                             @bind-Value="_minutes"
                             Label="Length (minutes)"
                             Min="0"
                             Max="@ScheduleRules.MaxMinutes"
                             Variant="Variant.Filled"
                             HelperText="@LengthHelp"
                             Class="mb-4"/>
            <ScheduleTimeField Value="@_startsAt"
                               ValueChanged="@(v => _startsAt = v)"
                               Label="Starts at"
                               HelperText="Optional. Leave empty to run on from the item before"/>
            @if (Item == null)
            {
                <MudCheckBox T="bool"
                             @bind-Value="_isSection"
                             Label="Section, with items under it (e.g. Games)"
                             Class="mt-2"/>
            }
        }
    </DialogContent>
    <DialogActions>
        @if (Item != null)
        {
            <MudButton Color="Color.Error" Disabled="@_busy" OnClick="@Remove">Remove</MudButton>
            <MudSpacer/>
        }
        <MudButton Disabled="@_busy" OnClick="@(() => MudDialog.Cancel())">Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   Disabled="@(_busy || string.IsNullOrWhiteSpace(_name))"
                   OnClick="@Save">
            @(Item == null ? "Add" : "Save")
        </MudButton>
    </DialogActions>
</MudDialog>
