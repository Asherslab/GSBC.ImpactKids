@inherits EntityUtilityComponent
@inject IRefreshableStore<Schedule>             SchedulesStore
@inject IRefreshableStore<ScheduleItemTemplate> ItemTemplatesStore
@inject IScheduleService                        ScheduleService
@inject IJSRuntime                              Js

@if (_schedule == null)
{
    @if (_status.HasError)
    {
        <MudAlert Severity="Severity.Error">@_status.Error</MudAlert>
    }
    else if (_status.HasData)
    {
        <MudAlert Severity="Severity.Warning">This schedule no longer exists.</MudAlert>
    }
    else
    {
        <MudProgressLinear Indeterminate Color="Color.Primary"/>
    }
}
else
{
    <div class="schedule" data-schedule-id="@_schedule.Id" @ref="_root">
        <div class="schedule-top">
            <span class="schedule-summary">
                @ScheduleFormat.Minutes(ScheduleTimeline.TotalMinutes(_schedule))
                @if (StartsAt is { } startsAt && EndsAt is { } endsAt)
                {
                    <span class="schedule-muted"> · @ScheduleFormat.Clock(startsAt)–@ScheduleFormat.Clock(endsAt)</span>
                }
                @if (_underway)
                {
                    <span class="schedule-underway">· underway, changes are recorded</span>
                }
            </span>
            <span class="schedule-groups">
                <span class="schedule-muted">Groups</span>
                @foreach (ScheduleGroup group in _schedule.Groups)
                {
                    <MudMenu Label="@group.Name" Size="Size.Small" Variant="Variant.Text" Dense="true">
                        <MudMenuItem OnClick="@(() => RenameGroup(group))">Rename</MudMenuItem>
                        <MudMenuItem OnClick="@(() => RemoveGroup(group))">Remove</MudMenuItem>
                    </MudMenu>
                }
                <MudIconButton Icon="@Icons.Material.Filled.Add"
                               Size="Size.Small"
                               aria-label="Add a group"
                               OnClick="@AddGroup"/>
            </span>
        </div>

        <MudPaper Elevation="3">
            <div class="schedule-sheet">
                @* The main list: together items and whole splits, one entry each, all draggable among each other. *@
                <div class="schedule-items schedule-main" data-lane-id="main">
                    @foreach (ScheduleEntry entry in _entries)
                    {
                        if (entry.Item != null)
                        {
                            @ItemRow(entry.Item)
                        }
                        else if (entry.Split != null)
                        {
                            @SplitRow(entry.Split)
                        }
                    }
                </div>
                <div class="schedule-add">
                    <MudMenu Label="Add" StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" Variant="Variant.Text" Dense="true">
                        @AddItemMenuItems(null)
                        <MudDivider/>
                        <MudMenuItem OnClick="@(() => AddSplit())">
                            Split @(_schedule.Groups.Count >= 2 ? $"by group ({_schedule.Groups.Count} lanes)" : "(2 lanes)")
                        </MudMenuItem>
                        <MudMenuItem Href="/Schedules/Items">Edit the item list…</MudMenuItem>
                    </MudMenu>
                </div>
            </div>
        </MudPaper>
    </div>
}

@code {

    // One row of the list, the same in the main list and in a split's lane.
    private RenderFragment ItemRow(ScheduleItem item) => __builder =>
    {
        TimedItem? timed = _timed.GetValueOrDefault(item.Id);

        <div class="schedule-item @(timed?.Clash == true ? "clash" : "") @(IsNow(timed) ? "now" : "")"
             data-item-id="@item.Id"
             @key="item.Id">
            <span class="schedule-drag-handle" aria-label="Drag to move">
                <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small"/>
            </span>
            <span class="schedule-item-time">
                @(timed?.Start is { } start ? ScheduleFormat.Clock(start) : "")
            </span>
            <span class="schedule-item-name" @onclick="@(() => EditItem(item))">
                @item.DisplayName
                @if (item.NeedsFillIn && string.IsNullOrWhiteSpace(item.FillIn))
                {
                    <span class="schedule-fill-in">to fill in</span>
                }
                @if (timed?.Clash == true)
                {
                    <span class="schedule-clash-note">the items before run past @ScheduleFormat.Clock(item.StartsAt!.Value)</span>
                }
            </span>
            <span class="schedule-item-length" @onclick="@(() => EditItem(item))">
                @ScheduleFormat.Minutes(item.Minutes)
                @if (item.AdjustmentMinutes != 0)
                {
                    <span class="schedule-adjustment">@($"{item.AdjustmentMinutes:+0;-0}")</span>
                }
            </span>
            @if (ShowAdjust)
            {
                <span class="schedule-item-actions">
                    <MudButton Size="Size.Small" Variant="Variant.Text"
                               OnClick="@(() => Adjust(item, -1))">−1</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text"
                               OnClick="@(() => Adjust(item, 1))">+1</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                               OnClick="@(() => Adjust(item, 5))">+5</MudButton>
                </span>
            }
        </div>
    };

    // A split as one entry of the main list: ruled above and below like an item, its lanes raised as cards.
    private RenderFragment SplitRow(ScheduleBlock block) => __builder =>
    {
        ImmutableList<LaneTiming> laneTimings = ScheduleTimeline.Lanes(block);
        TimedItem? first = block.Lanes.SelectMany(l => l.Items).Select(i => _timed.GetValueOrDefault(i.Id)).FirstOrDefault(t => t?.Start != null);

        <div class="schedule-split" data-block-id="@block.Id" @key="block.Id">
            <div class="schedule-split-header">
                <span class="schedule-drag-handle" aria-label="Drag to move">
                    <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small"/>
                </span>
                <span class="schedule-item-time">@(first?.Start is { } start ? ScheduleFormat.Clock(start) : "")</span>
                <span class="schedule-split-title">Split</span>
                <span class="schedule-item-length">@ScheduleFormat.Minutes(laneTimings.Count == 0 ? 0 : laneTimings.Max(l => l.Minutes))</span>
                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" AriaLabel="Split options">
                    <MudMenuItem Disabled="@(block.Lanes.Count >= ScheduleRules.MaxLanes)" OnClick="@(() => AddLane(block))">Add a lane</MudMenuItem>
                    <MudMenuItem OnClick="@(() => RemoveBlock(block))">Remove split</MudMenuItem>
                </MudMenu>
            </div>
            <div class="schedule-lanes" style="--lanes: @block.Lanes.Count">
                @foreach (ScheduleLane lane in block.Lanes)
                {
                    LaneTiming timing = laneTimings.First(t => t.LaneId == lane.Id);

                    <div class="schedule-lane mud-elevation-2" @key="lane.Id">
                        <div class="schedule-lane-header">
                            <span class="schedule-lane-name">@LaneName(lane)</span>
                            @if (timing.SpareMinutes > 0)
                            {
                                <span class="schedule-muted">· @timing.SpareMinutes min spare</span>
                            }
                            <MudSpacer/>
                            <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" AriaLabel="Lane options">
                                <MudMenuItem OnClick="@(() => ChooseLaneGroups(lane))">Choose groups…</MudMenuItem>
                                <MudMenuItem Disabled="@(block.Lanes.Count <= 2)" OnClick="@(() => RemoveLane(lane))">Remove lane</MudMenuItem>
                            </MudMenu>
                        </div>
                        <div class="schedule-items" data-lane-id="@lane.Id">
                            @foreach (ScheduleItem item in lane.Items)
                            {
                                @ItemRow(item)
                            }
                        </div>
                        <div class="schedule-add">
                            <MudMenu Label="Add" StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" Variant="Variant.Text" Dense="true">
                                @AddItemMenuItems(lane.Id)
                            </MudMenu>
                        </div>
                    </div>
                }
            </div>
        </div>
    };

    private RenderFragment AddItemMenuItems(Guid? laneId) => __builder =>
    {
        @foreach (ScheduleItemTemplate template in _itemTemplates)
        {
            <MudMenuItem OnClick="@(() => AddFromTemplate(laneId, template.Id))">
                @template.Name <span class="schedule-muted">· @ScheduleFormat.Minutes(template.Minutes)</span>
            </MudMenuItem>
        }
        <MudMenuItem OnClick="@(() => ScheduleItemDialog.Open(DialogService, null, ScheduleId, laneId, _underway))">One-off item…</MudMenuItem>
    };

}
