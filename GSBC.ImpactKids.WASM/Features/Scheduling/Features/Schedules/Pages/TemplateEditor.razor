@inherits EntityUtilityComponent
@page "/Schedules/Templates/{Id:guid}"
@inject IRefreshableStore<Schedule>    SchedulesStore
@inject IRefreshableStore<ServiceType> ServiceTypesStore
@inject IScheduleService               ScheduleService

<PageTitle>@(_template?.Name ?? "Schedule Template")</PageTitle>

<div class="mt-4">
    <MudStack Row AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-4">
        <MudIconButton Href="/Schedules/Templates" Icon="@Icons.Material.Filled.ArrowBack" aria-label="Back to templates"/>
        <MudText Typo="Typo.h5">@(_template?.Name ?? "Schedule Template")</MudText>
        @if (_template != null)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="Rename" OnClick="@Rename"/>
            <MudSpacer/>
            <div style="min-width: 220px">
                <MudSelect T="Guid?"
                           Value="@_template.DefaultForServiceTypeId"
                           ValueChanged="@SetDefault"
                           Label="Default for service type"
                           Clearable="true"
                           Dense="true"
                           Margin="Margin.Dense"
                           Variant="Variant.Outlined">
                    @foreach (ServiceType type in _serviceTypes)
                    {
                        <MudSelectItem T="Guid?" Value="@type.Id">@type.Label</MudSelectItem>
                    }
                </MudSelect>
            </div>
        }
    </MudStack>
    <ScheduleEditor ScheduleId="Id"/>
</div>
