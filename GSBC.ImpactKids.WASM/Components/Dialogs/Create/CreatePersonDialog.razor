@inject IPersonService PersonService

<BaseChangeDialog
    T="BasicResponse"
    Response="_response"
    OnSubmit="@Submit">
    <MudForm>
        <MudTextField Required
                      @bind-Value="_request.FirstName"
                      Label="First Name"
                      Class="mb-3"/>
        <MudTextField Required
                      @bind-Value="_request.LastName"
                      Label="Last Name"
                      Class="mb-3"/>
    </MudForm>
</BaseChangeDialog>