@typeparam FirstEntity
@typeparam SecondEntity
@typeparam EntityBeingAddedTo
@typeparam EntityToAdd
@inject IBasicMultipleRelationshipService<FirstEntity, SecondEntity> RelationshipService

<MudCard Elevation="6" Class="relative">
    <MudCardHeader>
        <CardHeaderContent>
            <MudPaper Elevation="0" Class="d-flex justify-space-between flex-grow-1">
                <MudText Typo="Typo.h6" Align="Align.Start" Inline>@Title</MudText>
                <MudPaper Elevation="0" Class="d-flex justify-end flex-grow-0">
                    <MudButton Size="Size.Small" Color="Color.Default"
                               OnClick="@AddEntityDialog">
                        <MudIcon Icon="@Icons.Material.Filled.AddCircle"/>
                    </MudButton>
                </MudPaper>
            </MudPaper>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <ListComponent T="EntityToAdd"
                       Filter="ListFilter"
                       Context="serviceId"
                       Spacing="3">
            @ChildContent(new RelationshipListEntry<FirstEntity, SecondEntity, EntityBeingAddedTo, EntityToAdd>(serviceId, this))
        </ListComponent>
    </MudCardContent>
</MudCard>