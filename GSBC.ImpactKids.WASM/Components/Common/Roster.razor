@inject IElvantoService ElvantoService

@if (_elvantoResponse != null)
{
    <MudHidden Breakpoint="MobileLayoutBreakpoint">
        <MudDataGrid Items="@_elvantoResponse.Positions"
                     Dense
                     Elevation="0"
                     FixedHeader>
            <Columns>
                <PropertyColumn StickyLeft Sortable="false" Property="x => x.Name" Title="Position"/>
                @foreach (string service in _elvantoResponse.Services)
                {
                    <PropertyColumn Sortable="false" Property="@(x => PositionForService(x, service))"
                                    Title="@(TitleForService(service))"/>
                }
            </Columns>
        </MudDataGrid>
    </MudHidden>
    <MudHidden Invert Breakpoint="MobileLayoutBreakpoint">
        <MudDataGrid Items="@_elvantoResponse.Services"
                     Dense
                     FixedHeader
                     Elevation="0"
                     Breakpoint="MobileLayoutBreakpoint">
            <Columns>
                <PropertyColumn StickyLeft Sortable="false" Property="x => TitleForService(x)" Title="Service"/>
                @foreach (ElvantoServicePosition position in _elvantoResponse.Positions)
                {
                    <PropertyColumn Sortable="false"
                                    Property="@(x => PositionForService(position, x))"
                                    Title="@(position.Name)"/>
                }
            </Columns>
        </MudDataGrid>
    </MudHidden>
}