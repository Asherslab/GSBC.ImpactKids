<MudHidden Breakpoint="Breakpoint.Xs">
    <MudToolBar Style="position: relative; justify-content: center; align-items: center;">
        <div class="side-left">
            <MudIconButton OnClick="@OnDelete" Icon="@Icons.Material.Filled.Delete"/>
            @LeftSideContent
        </div>
        <div class="center">
            @if (Subtitle == null)
            {
                <MudText Typo="Typo.h5">@Name</MudText>
            }
            else
            {
                <MudText Typo="Typo.h5" Class="mt-5" Align="Align.Center">@Name</MudText>
                <MudText Typo="Typo.body1" Align="Align.Center">@Subtitle</MudText>
            }
        </div>
        <div class="side-right">
            @RightSideContent
            <MudIconButton OnClick="@OnUpdate" Icon="@Icons.Material.Filled.Edit"/>
        </div>
    </MudToolBar>
</MudHidden>
<MudHidden Breakpoint="Breakpoint.Xs" Invert>
    <MudToolBar Style="position: relative; justify-content: center; align-items: center;">
        <div class="side-left">
            <MudIconButton OnClick="@OnDelete" Icon="@Icons.Material.Filled.Delete"/>
            @LeftSideContent
        </div>
        <div class="side-right">
            @RightSideContent
            <MudIconButton OnClick="@OnUpdate" Icon="@Icons.Material.Filled.Edit"/>
        </div>
    </MudToolBar>
    <div class="center">
        <MudText Align="Align.Center" Typo="Typo.h5">@Name</MudText>
        <MudText Typo="Typo.body1" Align="Align.Center">@Subtitle</MudText>
    </div>
</MudHidden>