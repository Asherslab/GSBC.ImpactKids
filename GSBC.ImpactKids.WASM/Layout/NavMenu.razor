@using GSBC.ImpactKids.WASM.Features.Scripture.Features.Memorisation.Pages
@using GSBC.ImpactKids.WASM.Services
@using GSBC.ImpactKids.WASM.Features.DataDisplay
@using GSBC.ImpactKids.WASM.Features.DataDisplay.Components
@using GSBC.ImpactKids.Shared.Contracts.Entities.Features.DataDisplay
@inject ElvantoReportsConfig ElvantoReportsConfig

<MudNavMenu>
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
    <MudNavLink Href="/roster" Icon="@Icons.Material.Filled.Schedule">Roster</MudNavLink>

    <MudNavLink Href="/calendar" Icon="@Icons.Material.Filled.CalendarMonth">Calendar</MudNavLink>

    <MudNavLink Href="/Attendance/Tool" Icon="@Icons.Material.Filled.Checklist">Attendance</MudNavLink>
    @* Its own top-level entry beside Attendance rather than under it: it is a job a leader does
       for a whole service, not a step inside signing one child in. *@
    <MudNavLink Href="/Photos" Icon="@Icons.Material.Filled.PhotoCamera">Photos</MudNavLink>
    <MudNavLink Href="/Songs" Icon="@Icons.Material.Filled.MusicNote">Songs</MudNavLink>

    <MudNavPopout Icon="@Icons.Material.Filled.EmojiEvents"
                  Title="Scoring">
        <MudMenuItem Icon="@Icons.Material.Filled.SportsEsports"
                     Label="Game Scoring"
                     Href="/Games/Points"/>
        <MudMenuItem Icon="@Icons.Material.Filled.Leaderboard"
                     Label="Totals"
                     Href="/Games/Scores"/>
    </MudNavPopout>

    <MudNavPopout Icon="@Icons.Material.Filled.School"
                  Title="Verse Memorisation">
        <MudMenuItem Icon="@Icons.Material.Filled.School"
                     Label="Memory Verses"
                     Href="/MemoryVerses"/>
        <MudMenuItem Icon="@Icons.Material.Filled.Undo"
                     Label="Previous"
                     Href="@($"/Scripture/Memorisation/Tool/{Guid.Empty}?{nameof(Tool.Previous)}={true}")"/>
        <MudMenuItem Icon="@Icons.Material.Filled.Redo"
                     Label="Upcoming"
                     Href="@($"/Scripture/Memorisation/Tool/{Guid.Empty}?{nameof(Tool.Upcoming)}={true}")"/>
    </MudNavPopout>
    <MudNavPopout Icon="@Icons.Material.Filled.Schedule"
                  Title="Services">
        <MudMenuItem Icon="@Icons.Material.Filled.Schedule"
                     Label="Services"
                     Href="/Services"/>
        <MudMenuItem Icon="@Icons.Material.Filled.Undo"
                     Label="Previous"
                     Href="/Services/Rel?Previous=true"/>
        <MudMenuItem Icon="@Icons.Material.Filled.Redo"
                     Label="Upcoming"
                     Href="/Services/Rel?Upcoming=true"/>
    </MudNavPopout>
    <MudNavLink Icon="@Icons.Material.Filled.Person"
                Href="/people">
        People
    </MudNavLink>
    <AuthorizeView Policy="@Policies.EnabledOnly">
        <MetabaseEmbedsLoader Context="menu">
            <MudNavPopout Icon="@Icons.Material.Filled.BarChart"
                          Title="Analytics">
                @foreach (MetabaseMenuEntry entry in menu)
                {
                    @if (entry.Embed.IsFolder)
                    {
                        <MudMenu Label="@entry.Embed.Label"
                                 StartIcon="@Icons.Material.Filled.Folder"
                                 Dense>
                            @foreach (MetabaseEmbed child in entry.Children)
                            {
                                <MudMenuItem Icon="@MetabaseMenu.Icon(child)"
                                             Label="@child.Label"
                                             Href="@MetabaseMenu.Href(child)"/>
                            }
                        </MudMenu>
                    }
                    else
                    {
                        <MudMenuItem Icon="@MetabaseMenu.Icon(entry.Embed)"
                                     Label="@entry.Embed.Label"
                                     Href="@MetabaseMenu.Href(entry.Embed)"/>
                    }
                }
            </MudNavPopout>
        </MetabaseEmbedsLoader>
    </AuthorizeView>
    @if (ElvantoReportsConfig.ReportLabels.Any())
    {
        <MudNavPopout Icon="@Icons.Material.Filled.ViewList"
                      Title="Reports">
            @foreach (string reportLabel in ElvantoReportsConfig.ReportLabels)
            {
                <MudMenuItem Icon="@Icons.Material.Filled.ViewList"
                             Label="@reportLabel"
                             Href="@($"/Reports/{reportLabel}")"/>
            }
        </MudNavPopout>
    }
    <MudNavPopout Icon="@Icons.Material.Filled.Settings"
                  Title="Admin">
        <MudMenuItem Icon="@Icons.Material.Filled.List"
                     Label="Service Types"
                     Href="/Services/ServiceTypes"/>
        <MudMenuItem Icon="@Icons.Material.Filled.ViewTimeline"
                     Label="Schedule Templates"
                     Href="/Schedules/Templates"/>
        <MudMenuItem Icon="@Icons.Material.Filled.Tv"
                     Label="Pickup Display"
                     Href="/Attendance/PickupDisplaySetup"/>
        <MudMenuItem Icon="@Icons.Material.Filled.Slideshow"
                     Label="ProPresenter"
                     Href="/ProPresenter/Machines"/>
        <MudMenuItem Icon="@Icons.Material.Filled.BarChart"
                     Label="Analytics Pages"
                     Href="/AnalyticsPages"/>
        <MudMenuItem Icon="@Icons.Material.Filled.ManageAccounts"
                     Label="Users"
                     Href="/users"/>
        <MudMenuItem Icon="@Icons.Material.Filled.Sync"
                     Label="Sync"
                     Href="/Sync"/>
        @* Beside Sync, because it is the same job by hand: Elvanto's API cannot accept a photo, so
           this is how photos get back into Elvanto. *@
        <MudMenuItem Icon="@Icons.Material.Filled.Download"
                     Label="Export Photos"
                     Href="/People/PhotoExport"/>
    </MudNavPopout>
</MudNavMenu>