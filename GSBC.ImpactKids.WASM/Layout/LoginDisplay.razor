<AuthorizeView>
    <Authorized>
        <MudLink OnClick="@BeginSignOut">Hello, @context.User.FindFirst("name")?.Value</MudLink>
    </Authorized>
    <NotAuthorized>
        <MudLink OnClick="@BeginSignIn">Log in</MudLink>
    </NotAuthorized>
</AuthorizeView>

@code
{
    protected override void OnInitialized()
    {
        Navigation.ToBaseRelativePath(Navigation.Uri);
    }

    private void BeginSignIn(MouseEventArgs args)
    {
        string loginUri = Navigation.GetUriWithQueryParameters("/bff/login", new Dictionary<string, object?>
            {
                { "ReturnUrl", Navigation.Uri },
            }
        );

        Navigation.NavigateTo(loginUri, forceLoad: true);
    }

    private void BeginSignOut(MouseEventArgs args)
    {
        string logoutUri = Navigation.GetUriWithQueryParameters("/bff/logout", new Dictionary<string, object?>
            {
                { "ReturnUrl", Navigation.Uri },
            }
        );

        Navigation.NavigateTo(logoutUri, forceLoad: true);
    }
}