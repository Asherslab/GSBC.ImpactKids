@using GSBC.ImpactKids.WASM.Features.Scripture.Features.Memorisation.Pages
@using GSBC.ImpactKids.WASM.Services
@using GSBC.ImpactKids.WASM.Features.DataDisplay
@using GSBC.ImpactKids.WASM.Features.DataDisplay.Components
@using GSBC.ImpactKids.Shared.Contracts.Entities.Features.DataDisplay
@inject ElvantoReportsConfig ElvantoReportsConfig

<MudNavMenu>
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
    <MudNavLink Href="/roster" Icon="@Icons.Material.Filled.Schedule">Roster</MudNavLink>

    <MudNavLink Href="/calendar" Icon="@Icons.Material.Filled.CalendarMonth">Calendar</MudNavLink>

    <MudNavLink Href="/Attendance/Tool" Icon="@Icons.Material.Filled.Checklist">Attendance</MudNavLink>
    @* Its own top-level entry beside Attendance rather than under it: it is a job a leader does
       for a whole service, not a step inside signing one child in. *@
    <MudNavLink Href="/Photos" Icon="@Icons.Material.Filled.PhotoCamera">Photos</MudNavLink>
    <MudNavLink Href="/Songs" Icon="@Icons.Material.Filled.MusicNote">Songs</MudNavLink>

    <MudNavGroup Icon="@Icons.Material.Filled.EmojiEvents"
                 Title="Scoring">
        <MudNavLink Icon="@Icons.Material.Filled.SportsEsports"
                    Href="/Games/Points">
            Game Scoring
        </MudNavLink>
        <MudNavLink Icon="@Icons.Material.Filled.Leaderboard"
                    Href="/Games/Scores">
            Totals
        </MudNavLink>
    </MudNavGroup>

    <MudNavGroup Icon="@Icons.Material.Filled.School"
                 Title="Verse Memorisation">
        <MudNavLink Icon="@Icons.Material.Filled.School"
                    Href="/MemoryVerses">
            Memory Verses
        </MudNavLink>
        <MudNavLink Icon="@Icons.Material.Filled.Undo"
                    Href="@($"/Scripture/Memorisation/Tool/{Guid.Empty}?{nameof(Tool.Previous)}={true}")">
            Previous
        </MudNavLink>
        <MudNavLink Icon="@Icons.Material.Filled.Redo"
                    Href="@($"/Scripture/Memorisation/Tool/{Guid.Empty}?{nameof(Tool.Upcoming)}={true}")">
            Upcoming
        </MudNavLink>
    </MudNavGroup>
    <MudNavGroup Icon="@Icons.Material.Filled.Schedule"
                 Title="Services">
        <MudNavLink Icon="@Icons.Material.Filled.Schedule"
                    Href="/Services">
            Services
        </MudNavLink>
        <MudNavLink Icon="@Icons.Material.Filled.Undo"
                    Href="/Services/Rel?Previous=true">
            Previous
        </MudNavLink>
        <MudNavLink Icon="@Icons.Material.Filled.Redo"
                    Href="/Services/Rel?Upcoming=true">
            Upcoming
        </MudNavLink>
    </MudNavGroup>
    <MudNavLink Icon="@Icons.Material.Filled.Person"
                Href="/people">
        People
    </MudNavLink>
    <AuthorizeView Policy="@Policies.EnabledOnly">
        <MetabaseEmbedsLoader Context="menu">
            <MudNavGroup Icon="@Icons.Material.Filled.BarChart"
                         Title="Analytics">
                @foreach (MetabaseMenuEntry entry in menu)
                {
                    @if (entry.Embed.IsFolder)
                    {
                        <MudNavGroup Icon="@Icons.Material.Filled.Folder"
                                     Title="@entry.Embed.Label">
                            @foreach (MetabaseEmbed child in entry.Children)
                            {
                                <MudNavLink Icon="@MetabaseMenu.Icon(child)"
                                            Href="@MetabaseMenu.Href(child)">
                                    @child.Label
                                </MudNavLink>
                            }
                        </MudNavGroup>
                    }
                    else
                    {
                        <MudNavLink Icon="@MetabaseMenu.Icon(entry.Embed)"
                                    Href="@MetabaseMenu.Href(entry.Embed)">
                            @entry.Embed.Label
                        </MudNavLink>
                    }
                }
            </MudNavGroup>
        </MetabaseEmbedsLoader>
    </AuthorizeView>
    @if (ElvantoReportsConfig.ReportLabels.Any())
    {
        <MudNavGroup Icon="@Icons.Material.Filled.ViewList"
                     Title="Reports">
            @foreach (string reportLabel in ElvantoReportsConfig.ReportLabels)
            {
                <MudNavLink Icon="@Icons.Material.Filled.ViewList"
                            Href="@($"/Reports/{reportLabel}")">
                    @reportLabel
                </MudNavLink>
            }
        </MudNavGroup>
    }
    <MudNavGroup Icon="@Icons.Material.Filled.Settings"
                 Title="Admin">
        <MudNavLink Icon="@Icons.Material.Filled.Book"
                    Href="/bible">
            Bible
        </MudNavLink>
        <MudNavLink Icon="@Icons.Material.Filled.List"
                    Href="/Services/ServiceTypes">
            Service Types
        </MudNavLink>
        <MudNavLink Icon="@Icons.Material.Filled.ViewTimeline"
                    Href="/Schedules/Templates">
            Schedule Templates
        </MudNavLink>
        <MudNavLink Icon="@Icons.Material.Filled.Tv"
                    Href="/Attendance/PickupDisplaySetup">
            Pickup Display
        </MudNavLink>
        <MudNavLink Icon="@Icons.Material.Filled.Slideshow"
                    Href="/ProPresenter/Machines">
            ProPresenter
        </MudNavLink>
        <MudNavLink Icon="@Icons.Material.Filled.BarChart"
                    Href="/AnalyticsPages">
            Analytics Pages
        </MudNavLink>
        <MudNavLink Icon="@Icons.Material.Filled.ManageAccounts"
                    Href="/users">
            Users
        </MudNavLink>
    </MudNavGroup>
</MudNavMenu>