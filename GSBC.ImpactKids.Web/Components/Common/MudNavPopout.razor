<MudMenu
    Dense
    AnchorOrigin="Origin.CenterRight"
    TransformOrigin="Origin.TopLeft"
    OpenChanged="@MenuOpenChanged"
    Style="width: 100%"
    ChildContent="ChildContent">
    <ActivatorContent>
        <MudNavGroup Icon="@Icon" Title="@Title"
                     ExpandIcon="@Icons.Material.Filled.NavigateBefore"
                     Expanded="@_menuOpen"/>
    </ActivatorContent>
</MudMenu>

@code {

    [Parameter]
    public string? Icon { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private bool _menuOpen;

    private void MenuOpenChanged(bool b)
    {
        _menuOpen = b;
        StateHasChanged();
    }

}