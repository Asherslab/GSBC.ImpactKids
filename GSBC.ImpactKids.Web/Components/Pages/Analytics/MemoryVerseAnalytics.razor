@page "/Analytics/MemoryVerses"
@using GSBC.ImpactKids.Web.Services
@attribute [Authorize(Policy = Policies.EnabledOnly)]
@inject MetabaseConfig   MetabaseConfig
@inject IMetabaseService MetabaseService

<PageTitle>Verse Memorisation Analytics</PageTitle>

<MudPaper Elevation="6" Class="mt-4" Style="height: 90vh">
    @if (_token != null)
    {
        <iframe
            src="@DashboardUrl()"
            width="100%"
            height="100%"
            allowtransparency>
        </iframe>
    }
</MudPaper>