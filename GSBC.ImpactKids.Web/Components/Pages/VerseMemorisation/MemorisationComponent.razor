@using GSBC.ImpactKids.Shared.Contracts.Entities.MemoryVerses
@inherits EventListeningComponent
@attribute [Authorize(Policy = Policies.EnabledOnly)]
@inject IServicesService            ServicesService
@inject IMemoryVersesService        MemoryVersesService
@inject IMemorisationEntriesService MemorisationEntriesService
@inject ISnackbar                   Snackbar
@inject IDialogService              DialogService
@inject NavigationManager           Navigation

<MudPaper Elevation="6" Class="mt-4">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6" Align="Align.Center">Verse Memorisation Recording Tool</MudText>
                @if (_service != null)
                {
                    <MudText Typo="Typo.subtitle1" Align="Align.Center">Recording for
                        Service: @_service?.GetDisplayName()</MudText>
                }
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <MudDivider/>
            @if (_memoryVerses != null && SelectedMemoryVerse != null)
            {
                <MudSelect T="Guid"
                           Value="@SelectedMemoryVerse.Value"
                           ValueChanged="SelectedMemoryVerseChanged"
                           Clearable="false"
                           Required
                           Class="pa-3">
                    @foreach (MemoryVerse verse in _memoryVerses)
                    {
                        <MudSelectItem Value="@verse.Id">@verse.ReferenceName</MudSelectItem>
                    }
                </MudSelect>
            }
            @if (_selectedVerse != null)
            {
                <MudCard Elevation="3">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Align="Align.Center">@_selectedVerse.ReferenceName</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText>@_selectedVerse.Verse</MudText>
                    </MudCardContent>
                    <MudCardActions Class="justify-end">
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Primary"
                                   OnClick="@ShowOriginalText">
                            Show Original Text
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            }
            <MudTextField
                T="string"
                Value="Search"
                ValueChanged="@(OnSearch)"
                Placeholder="Search for People"
                Adornment="Adornment.Start"
                AdornmentIcon="@Icons.Material.Filled.Search"
                DebounceInterval="100"
                IconSize="Size.Medium"
                Clearable="true"
                Class="py-6 px-6"/>
            <MudTable Elevation="6" Items="_memorisationEntries" Hover="true" Breakpoint="Breakpoint.None">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh Style="width: 100px">Recited</MudTh>
                    <MudTh Style="width: 25px">$5</MudTh>
                    <MudTh Style="width: 25px">$1</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name">@context.Person?.GetDisplayName()</MudTd>
                    <MudTd DataLabel="Recited">
                        <MudStack Row>
                            <MudCheckBox T="bool"
                                         Value="@context.VerseRecited"
                                         ValueChanged="@(() => UpdateMemorisationEntry(context, recited: !context.VerseRecited))"/>
                            @if (context is { VerseHasBeenRecitedBefore: false, VerseRecited: true })
                            {
                                <MudTooltip
                                    RootStyle="display: flex !important"
                                    ShowOnClick
                                    ShowOnHover
                                    ShowOnFocus
                                    Text="This is the first time this verse has been recited!">
                                    <MudIcon tabindex="0" Icon="@Icons.Material.Filled.NewReleases"/>
                                </MudTooltip>
                            }
                        </MudStack>
                    </MudTd>
                    <MudTd DataLabel="$5">
                        @if (context.VerseHasBeenRecitedBefore)
                        {
                            <MudTooltip
                                RootStyle="display: flex !important"
                                ShowOnClick
                                ShowOnHover
                                ShowOnFocus
                                Text="This verse has been recited before, give 1 dollary doo instead">
                                <MudCheckBox T="bool"
                                             Disabled
                                             tabindex="0"
                                             Value="false"/>
                            </MudTooltip>
                        }
                        else
                        {
                            <MudCheckBox T="bool"
                                         Value="@context.FiveDollaryDoosGiven"
                                         ValueChanged="@(() => UpdateMemorisationEntry(context, fiveDollaryDoos: !context.FiveDollaryDoosGiven))"/>
                        }
                    </MudTd>
                    <MudTd DataLabel="$1">
                        @if (!context.VerseHasBeenRecitedBefore)
                        {
                            <MudTooltip
                                RootStyle="display: flex !important"
                                ShowOnClick
                                ShowOnHover
                                ShowOnFocus
                                Text="This verse has not been recited before, give 5 dollary doo instead">
                                <MudCheckBox T="bool"
                                             Disabled
                                             tabindex="0"
                                             Value="false"/>
                            </MudTooltip>
                        }
                        else
                        {
                            <MudCheckBox T="bool"
                                         Value="@context.OneDollaryDooGiven"
                                         ValueChanged="@(() => UpdateMemorisationEntry(context, oneDollaryDoo: !context.OneDollaryDooGiven))"/>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudCardContent>
    </MudCard>
</MudPaper>