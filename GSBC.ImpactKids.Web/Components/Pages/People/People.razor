@inherits EventListeningComponent
@page "/People"
@attribute [Authorize(Policy = Policies.EnabledOnly)]
@inject IPeopleService    PeopleService
@inject ISnackbar         Snackbar
@inject NavigationManager Navigation
@inject IDialogService    DialogService

<PageTitle>People</PageTitle>

<MudPaper Elevation="6" Class="mt-4">
    <MudButton FullWidth
               Class="py-5"
               OnClick="@SyncElvantoPeople"
               StartIcon="@Icons.Material.Filled.Sync">
        Sync Elvanto Users
    </MudButton>
    <MudTextField
        T="string"
        Value="Search"
        ValueChanged="@(OnSearch)"
        Placeholder="Search"
        Adornment="Adornment.Start"
        AdornmentIcon="@Icons.Material.Filled.Search"
        DebounceInterval="100"
        IconSize="Size.Medium"
        Clearable="true"
        Class="py-6 px-6"/>
    <MudTable Items="_people" Hover="true" Breakpoint="Breakpoint.None">
        <HeaderContent>
            <MudTh>
                <MudIconButton OnClick="@CreatePerson"
                               Icon="@Icons.Material.Filled.PostAdd"/>
            </MudTh>
            <MudTh>First Name</MudTh>
            <MudTh>Last Name</MudTh>
            <MudTh>Preferred Name</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                <MudIconButton OnClick="@(_ => DeletePerson(context))"
                               Icon="@Icons.Material.Filled.Delete"/>
                <MudIconButton OnClick="@(_ => UpdatePerson(context))"
                               Icon="@Icons.Material.Filled.Edit"/>
            </MudTd>
            <MudTd DataLabel="First Name">@context.FirstName</MudTd>
            <MudTd DataLabel="Last Name">@context.LastName</MudTd>
            <MudTd DataLabel="Preferred Name">@context.PreferredName</MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>