@using GSBC.ImpactKids.Shared.Contracts.Entities.Bible
@using GSBC.ImpactKids.Shared.Contracts.Entities.MemoryVerses
@inject IMemoryVersesService     MemoryVersesService
@inject IMemoryVerseListsService MemoryVerseListsService
@inject IServicesService         ServicesService
@inject IBibleService            BibleService
@inject ISnackbar                Snackbar

<MudDialog>
    <TitleContent>
        @MudDialog.Title
    </TitleContent>
    <DialogContent>
        <MudStepper Vertical>
            <MudStep Title="Select Bible Verses">
                <MudTextField
                    T="string"
                    Value="_bibleSearch"
                    ValueChanged="@(OnBibleSearch)"
                    Placeholder="Search"
                    Adornment="Adornment.Start"
                    AdornmentIcon="@Icons.Material.Filled.Search"
                    DebounceInterval="100"
                    IconSize="Size.Medium"
                    Clearable="true"
                    Class="py-6 px-6"/>
                <MudGrid Spacing="1" Justify="Justify.Center" Class="px-1 py-1">
                    @foreach (BibleVerse verse in _selectedVerses)
                    {
                        if (_verses?.Any(x => x.Id == verse.Id) ?? false)
                        {
                            continue;
                        }

                        <MudItem xs="12" md="6" lg="3">
                            <MudCard Elevation="6" Style="height: 100%">
                                <MudCardHeader>
                                    <CardHeaderActions>
                                        <MudCheckBox T="bool" Value="@true"
                                                     ValueChanged="@(() => AddOrRemoveBibleVerse(verse))"/>
                                    </CardHeaderActions>
                                    <CardHeaderContent>
                                        <MudText
                                            Typo="Typo.h6">@verse.BookName @verse.ChapterNumber : @verse.VerseNumber</MudText>
                                    </CardHeaderContent>
                                </MudCardHeader>
                                <MudCardContent>
                                    <MudText>@verse.Verse</MudText>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    }
                    @if (_verses is { Count: > 0 })
                    {
                        foreach (BibleVerse verse in _verses)
                        {
                            <MudItem xs="12" md="6" lg="3">
                                <MudCard Elevation="6" Style="height: 100%">
                                    <MudCardHeader>
                                        <CardHeaderActions>
                                            <MudCheckBox T="bool" Value="@(_selectedVerses.Any(x => x.Id == verse.Id))"
                                                         ValueChanged="@(() => AddOrRemoveBibleVerse(verse))"/>
                                        </CardHeaderActions>
                                        <CardHeaderContent>
                                            <MudText
                                                Typo="Typo.h6">@verse.BookName @verse.ChapterNumber : @verse.VerseNumber</MudText>
                                        </CardHeaderContent>
                                    </MudCardHeader>
                                    <MudCardContent>
                                        <MudText>@verse.Verse</MudText>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                        }
                    }
                    else
                    {
                        for (int i = 0; i < 5; i++)
                        {
                            <MudItem xs="12" md="6" lg="3">
                                <MudCard>
                                    <MudCardHeader>
                                        <CardHeaderActions>
                                            <MudSkeleton Animation="Animation.Wave" Width="5%"/>
                                        </CardHeaderActions>
                                        <CardHeaderContent>
                                            <MudSkeleton Animation="Animation.Wave" Width="60%"/>
                                        </CardHeaderContent>
                                    </MudCardHeader>
                                    <MudCardContent>
                                        <MudSkeleton Animation="Animation.Wave" Width="100%"/>
                                        <MudSkeleton Animation="Animation.Wave" Width="95%"/>
                                        <MudSkeleton Animation="Animation.Wave" Width="30%"/>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                        }
                    }
                </MudGrid>
            </MudStep>
            <MudStep Title="Select Services" Disabled="@(_selectedVerses.Count == 0)">
                <MudTextField
                    T="string"
                    Value="_serviceSearch"
                    ValueChanged="@(OnServiceSearch)"
                    Placeholder="Search"
                    Adornment="Adornment.Start"
                    AdornmentIcon="@Icons.Material.Filled.Search"
                    DebounceInterval="100"
                    IconSize="Size.Medium"
                    Clearable="true"
                    Class="py-6 px-6"/>
                <MudGrid Spacing="1" Justify="Justify.Center" Class="px-1 py-1">
                    @if (_services is { Count: > 0 })
                    {
                        foreach (Service service in _services)
                        {
                            <MudItem xs="12" md="6" lg="3">
                                <MudCard Elevation="6" Style="height: 100%">
                                    <MudCardHeader>
                                        <CardHeaderActions>
                                            <MudCheckBox T="bool"
                                                         Value="@(_selectedServices.Any(x => x.Id == service.Id))"
                                                         ValueChanged="@(() => AddOrRemoveService(service))"/>
                                        </CardHeaderActions>
                                        <CardHeaderContent>
                                            <MudText
                                                Typo="Typo.h6">@(service.Name ?? service.Date.ToString("dd-MM-yyyy"))</MudText>
                                        </CardHeaderContent>
                                    </MudCardHeader>
                                    <MudCardContent>
                                        <MudText>@(service.Name == null ? "" : service.Date.ToString("dd-MM-yyyy"))</MudText>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                        }
                    }
                    else
                    {
                        for (int i = 0; i < 5; i++)
                        {
                            <MudItem xs="12" md="6" lg="3">
                                <MudCard>
                                    <MudCardHeader>
                                        <CardHeaderActions>
                                            <MudSkeleton Animation="Animation.Wave" Width="5%"/>
                                        </CardHeaderActions>
                                        <CardHeaderContent>
                                            <MudSkeleton Animation="Animation.Wave" Width="60%"/>
                                        </CardHeaderContent>
                                    </MudCardHeader>
                                    <MudCardContent>
                                        <MudSkeleton Animation="Animation.Wave" Width="100%"/>
                                        <MudSkeleton Animation="Animation.Wave" Width="95%"/>
                                        <MudSkeleton Animation="Animation.Wave" Width="30%"/>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                        }
                    }
                </MudGrid>
            </MudStep>
            <MudStep @ref="_submitStep" Title="Enter Memory Verse Details" 
                     Disabled="@(_selectedServices.Count == 0)"
                     CompletedChanged="@(() => Submit())">
                <MudForm Class="py-3">
                    <MudTextField Required
                                  @bind-Value="_request.ReferenceName.Value"
                                  Label="Name"
                                  Class="mb-3"/>
                    <MudTextField Required
                                  Lines="5"
                                  @bind-Value="_request.Verse.Value"
                                  Label="Verse Text"
                                  Class="mb-3"/>
                    <MudAutocomplete
                        T="MemoryVerseList?"
                        @bind-Value="List"
                        DebounceInterval="100"
                        Immediate="true"
                        CloseIcon="@Icons.Material.Filled.Search"
                        SearchFunc="ListSearchFunc"
                        ToStringFunc="@(x => x?.Name ?? "")"
                        Clearable="true"
                        ShowProgressIndicator="true">
                        <ProgressIndicatorTemplate>
                            <MudProgressLinear Size="Size.Small" Indeterminate="true"/>
                        </ProgressIndicatorTemplate>
                        <ProgressIndicatorInPopoverTemplate>
                            <MudList T="string" ReadOnly="true">
                                <MudListItem T="string">
                                    Loading...
                                </MudListItem>
                            </MudList>
                        </ProgressIndicatorInPopoverTemplate>
                    </MudAutocomplete>
                </MudForm>
            </MudStep>
        </MudStepper>
    </DialogContent>
</MudDialog>


