{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy.Forwarder": "Warning"
    }
  },
  "OpenIDConnectSettings": {
    "Authority": "https://dev-uen143eh00y54f67.us.auth0.com",
    "ClientId": "RNqxyojKImr774ErPQw34xKl02YLaOlf",
    "Audience": "https://kids.baptist.com.au"
  },
  "ReverseProxy": {
    "Routes": {
      "grpc": {
        "_comment": "Leaders and wall displays both, because both are real callers now. This route no longer decides what either may do - the gRPC service authenticates each caller itself and gates every method, admitting a display only to reads marked for it. See GSBC.ImpactKids.Grpc/Policies.cs.",
        "ClusterId": "grpc",
        "AuthorizationPolicy": "LeaderOrDisplay",
        "Match": {
          "Path": "/gRPC/GSBC.ImpactKids.{service}/{**catch-all}"
        }
      },
      "api": {
        "_comment": "Carries /api/stream, the change notification a display now refreshes off instead of its own server streamed list.",
        "ClusterId": "grpc",
        "AuthorizationPolicy": "LeaderOrDisplay",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "wasm": {
        "ClusterId": "wasm",
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "grpc": {
        "Destinations": {
          "grpc": {
            "Address": "http://grpc"
          }
        }
      },
      "wasm": {
        "Destinations": {
          "wasm": {
            "Address": "http://wasm"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
