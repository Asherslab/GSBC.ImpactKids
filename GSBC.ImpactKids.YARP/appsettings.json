  "ReverseProxy": {
    "Routes": {
      "grpc": {
        "ClusterId": "grpc",
        "CorsPolicy": "allow-all",
        "Match": {
          "Path": "/gRPC/GSBC.ImpactKids.{service}/{**catch-all}"
        }
      },
      "api": {
        "ClusterId": "grpc",
        "CorsPolicy": "allow-all",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "wasm": {
        "ClusterId": "wasm",
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "grpc": {
        "Destinations": {
          "grpc": {
            "Address": "https://grpc"
          }
        }
      },
      "wasm": {
        "Destinations": {
          "wasm": {
            "Address": "https://wasm"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
