{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy.Forwarder": "Warning"
    }
  },
  "OpenIDConnectSettings": {
    "Authority": "https://dev-uen143eh00y54f67.us.auth0.com",
    "ClientId": "RNqxyojKImr774ErPQw34xKl02YLaOlf",
    "Audience": "https://kids.baptist.com.au"
  },
  "ReverseProxy": {
    "Routes": {
      "grpc": {
        "ClusterId": "grpc",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/gRPC/GSBC.ImpactKids.{service}/{**catch-all}"
        }
      },
      "api": {
        "ClusterId": "grpc",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "public": {
        "_comment": "Anonymous on purpose - a screen on a wall cannot sign in. Routed service by service, NEVER by a /public/ prefix: a catch-all here would make every future service under that prefix anonymous by default. Read-only scoreboard aggregates only.",
        "ClusterId": "grpc",
        "Match": {
          "Path": "/public/GSBC.ImpactKids.Games.Display/{**catch-all}"
        }
      },
      "public-attendance-pickup": {
        "_comment": "Anonymous on purpose - the pickup wall cannot sign in either. Returns only the children currently requested and not yet signed out, as a display name (first name plus last initial) and a timestamp. No ids, no roster, no history. See docs/work/2026-08-pickup-requests-and-activity-log.md.",
        "ClusterId": "grpc",
        "Match": {
          "Path": "/public/GSBC.ImpactKids.Attendance.Display/{**catch-all}"
        }
      },
      "wasm": {
        "ClusterId": "wasm",
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "grpc": {
        "Destinations": {
          "grpc": {
            "Address": "http://grpc"
          }
        }
      },
      "wasm": {
        "Destinations": {
          "wasm": {
            "Address": "http://wasm"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
