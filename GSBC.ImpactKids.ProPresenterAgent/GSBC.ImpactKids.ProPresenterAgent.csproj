<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AssemblyName>impactkids-propresenter-agent</AssemblyName>
        <RootNamespace>GSBC.ImpactKids.ProPresenterAgent</RootNamespace>
        <!-- Runs on the ProPresenter Mac, never in the cluster: no Dockerfile, not in the Helm chart. -->
        <RuntimeIdentifiers>osx-x64;osx-arm64</RuntimeIdentifiers>
        <!-- Stamped by the release job with the app's semantic version; the admin page shows it. -->
        <Version>0.0.0-local</Version>
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

    <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
        <SelfContained>true</SelfContained>
        <PublishSingleFile>true</PublishSingleFile>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <!-- About halves the download; costs a fraction of a second at a start that happens once per login. -->
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        <DebugType>none</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Grpc.Net.Client" Version="2.71.0"/>
        <PackageReference Include="Grpc.Net.Client.Web" Version="2.71.0"/>
        <!-- ProPresenter's workspace registry; see ProPresenter/ProPresenterWorkspaces.cs. -->
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.1"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\GSBC.ImpactKids.Shared.Contracts\GSBC.ImpactKids.Shared.Contracts.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Shipped beside the binary in the release zip, not compiled in. -->
        <None Update="install\*.sh" CopyToOutputDirectory="Never"/>
    </ItemGroup>

</Project>
